def milestones(config, state):
    return rest("GET", f"repos/{config['repo']}/milestones?state={state}&per_page=100")


def milestone_rank(milestone):
    """Version order of the title (digit runs compared as numbers: 0.10.0 > 0.9.0 > 0.3.0 > 0.2.1), then creation order."""
    parts = re.findall(r"\d+|\D+", milestone["title"].casefold())
    return [(1, int(part), "") if part.isdigit() else (0, 0, part) for part in parts], milestone["number"]


def latest_milestone(config):
    """Number of the highest open milestone (milestone_rank), or None. Track milestones (branch.tracks)
    never: new work lands on base, joining a track is the user's call."""
    tracks = set(config.get("tracks", []))
    opened = [m for m in milestones(config, "open") if m["title"] not in tracks]
    return max(opened, key=milestone_rank)["number"] if opened else None


def op_milestones(args):
    config = load()
    highest_first = lambda ms: sorted(ms, key=milestone_rank, reverse=True)
    rows = highest_first(milestones(config, "open"))
    rows += [m for m in highest_first(milestones(config, "closed")) if m["open_issues"]]
    emit([
        {"title": m["title"], "open": m["state"] == "open", "tickets": m["open_issues"] + m["closed_issues"], "done": m["closed_issues"]}
        for m in rows
    ])


def milestone_number(config, title):
    """Milestones are made and closed by humans: an unknown title is an error, never created. "" = none."""
    if not title:
        return None
    found = [m for m in milestones(config, "all") if m["title"] == title]
    if not found:
        raise Failure(f"no milestone {title!r} — create it on GitHub first", EXIT_USAGE)
    return found[0]["number"]


def op_close_milestone(args):
    """Close a shipped milestone. Only /wa-release calls it, on the user's yes."""
    config = load()
    number = milestone_number(config, args.title)
    if number is None:
        raise Failure("milestone title required", EXIT_USAGE)
    rest("PATCH", f"repos/{config['repo']}/milestones/{number}", {"state": "closed"})
    emit({"title": args.title, "open": False})


def set_milestone(config, number, title):
    rest("PATCH", f"repos/{config['repo']}/issues/{number}", {"milestone": milestone_number(config, title)})


def sprint_issues(config, name):
    return [
        i for i in rest("GET", f"repos/{config['repo']}/issues?labels={SPRINT_LABEL}&state=all&per_page=100")
        if sprint_name(i["title"]) == name and "pull_request" not in i
    ]


def sprint_issue(config, name):
    """Number of sprint <name>'s parent issue, created on first use. A closed one (sprint landed
    before) is reopened: same name, same sprint."""
    repo = config["repo"]
    found = sprint_issues(config, name)
    if found:
        if found[0]["state"] == "closed":
            rest("PATCH", f"repos/{repo}/issues/{found[0]['number']}", {"state": "open"})
        return found[0]["number"]
    body = "Sprint: whackagent groups its tickets here as sub-issues. Closed when the sprint lands."
    return rest("POST", f"repos/{repo}/issues", {"title": name, "body": body, "labels": [SPRINT_LABEL]})["number"]


def set_sprint(config, number, sprint):
    """Make the ticket a sub-issue of sprint <sprint>'s parent issue; "" detaches it."""
    repo = config["repo"]
    sprint = sprint_name(sprint)
    owner, name = repo.split("/")
    parent = graphql(
        "query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){issue(number:$n){parent{number title labels(first:20){nodes{name}}}}}}",
        o=owner, r=name, n=number,
    )["repository"]["issue"]["parent"]
    if parent and not is_sprint(parent):  # one parent per issue: never replace a human's own hierarchy
        raise Failure(f"#{number} is already a sub-issue of #{parent['number']} (not a sprint) — detach it first", EXIT_WRONG_STATE)
    if sprint_of(parent) == (sprint or None):
        return
    issue_id = rest("GET", f"repos/{repo}/issues/{number}")["id"]
    if not sprint:
        rest("DELETE", f"repos/{repo}/issues/{parent['number']}/sub_issue", {"sub_issue_id": issue_id})
        return
    target = sprint_issue(config, sprint)
    rest("POST", f"repos/{repo}/issues/{target}/sub_issues", {"sub_issue_id": issue_id, "replace_parent": True})


def op_set_field(args):
    config = load()
    if args.field == "size":
        if args.value not in SIZES:
            raise Failure(f"size must be one of {SIZES}", EXIT_USAGE)
        set_size(config, find(config, args.number, with_owners=False), args.value)
    elif args.field == "sprint":
        set_sprint(config, args.number, args.value)
    else:
        set_milestone(config, args.number, args.value)
    emit({"number": args.number, args.field: args.value or None})


def op_split(args):
    """The ticket becomes the root of its split: sprint named after its title, off the board, children
    join it as sub-issues (create --sprint <name>). Number, history and milestone stay."""
    config = load()
    number = args.number
    ticket = find(config, number, with_owners=False)
    if ticket["closed"]:
        raise Failure(f"#{number} is closed", EXIT_WRONG_STATE)
    if ticket["sprint"]:  # sprints don't nest: the children join this one instead
        raise Failure(f"#{number} is already in sprint {ticket['sprint']!r}", EXIT_WRONG_STATE)
    if ticket["claims"]:
        held = ", ".join(c["phase"] for c in ticket["claims"])
        raise Failure(f"#{number} is claimed ({held}) — release it first", EXIT_WRONG_STATE)
    name = sprint_name(ticket["title"])
    if not name:
        raise Failure(f"#{number} title has no letter or digit to name a sprint", EXIT_USAGE)
    clash = sprint_issues(config, name)
    if clash:
        raise Failure(f"sprint {name!r} already exists (#{clash[0]['number']}) — retitle #{number} first", EXIT_WRONG_STATE)
    rest("POST", f"repos/{config['repo']}/issues/{number}/labels", {"labels": [SPRINT_LABEL]})
    graphql(
        "mutation($p:ID!,$i:ID!){deleteProjectV2Item(input:{projectId:$p,itemId:$i}){deletedItemId}}",
        p=config["project_id"],
        i=ticket["item_id"],
    )
    comment(config, number, f"🌳 **split** — sprint `{name}`, its tickets are the sub-issues of this issue")
    emit({"number": number, "sprint": name})


def op_comment(args):
    config = load()
    if args.body_file is None:
