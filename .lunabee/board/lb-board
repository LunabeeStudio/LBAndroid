    emit({"title": args.title, "open": False})


def op_split(args):
    """The ticket becomes the root of its split: sprint named after its title, off the board, children join it
    (create --sprint <name>). Key, history and milestone stay."""
    board = open_board()
    number = args.number
    ticket = find(board, number, with_owners=False)
    if ticket["closed"]:
        raise Failure(f"{number} is closed", EXIT_WRONG_STATE)
    if ticket["sprint"]:  # sprints don't nest: the children join this one instead
        raise Failure(f"{number} is already in sprint {ticket['sprint']!r}", EXIT_WRONG_STATE)
    if ticket["claims"]:
        held = ", ".join(c["phase"] for c in ticket["claims"])
        raise Failure(f"{number} is claimed ({held}) — release it first", EXIT_WRONG_STATE)
    name = sprint_name(ticket["title"])
    if not name:
        raise Failure(f"{number} title has no letter or digit to name a sprint", EXIT_USAGE)
    board.split(ticket, name)
    emit({"number": number, "sprint": name})


def op_comment(args):
    board = open_board()
    if args.body_file is None:
        text = args.text
    elif args.body_file == "-":
        text = sys.stdin.read()
    else:
        text = Path(args.body_file).read_text()
    board.comment(args.number, text)
    emit({"number": args.number, "commented": True})


def op_link_pr(args):
    """Manual link from PR <pr> to ticket <n>. Idempotent. Repair only: the hooks link every PR whose ticket they find."""
    linked = open_board().link_pr(args.number, args.pr)
    emit({"number": args.number, "pr": args.pr, "linked": True, "added": linked})


def op_claims(args):
    board = open_board()
    config = board.config
    branches = ticket_branches(board)
    now = dt.datetime.now(dt.timezone.utc)

    def row(number, claim):
        owner = claim_owner(config, claim["sha"])
        heads = [rest("GET", f"repos/{config['repo']}/git/commits/{sha}")["committer"]["date"]
                 for sha in branches.get(number, {}).values()]
        latest = max([owner["since"], *heads])
        age = now - dt.datetime.fromisoformat(latest.replace("Z", "+00:00"))
        return {
            "number": number,
            "phase": claim["phase"],
            **owner,
            "branches": sorted(branches.get(number, {})),
            "last_activity": latest,
            "stale": age.total_seconds() > config["stale_after_hours"] * 3600,
        }

    work = [(number, claim) for number, held in sorted(claims(config).items()) for claim in held]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        emit(list(pool.map(lambda job: row(*job), work)))


def op_whoami(args):
