# ---------------------------------------------------------------- hooks: GitHub event → board writes
# One handler per event name (push, pull_request); any other event is a no-op. Each returns {action, reason}, and
# `op_hook` logs one line. The receiver runs them from the default branch, one at a time per repository.


def claimer(config, number, phases):
    """Board account of the first claim held among <phases>: the dev whose round moves the ticket. Read before the
    hook drops the claim."""
    held = {c["phase"]: c["sha"] for c in claims(config, number)}
    for phase in (p for p in phases if p in held):
        fields = claim_fields(config, held[phase])
        if fields.get("account") or fields.get("assigned"):
            return fields.get("account") or fields.get("assigned")
    return None


def assign_developer(board, ticket, account):
    """Ticket moved to review with nobody assigned: the round's dev takes it. A GitHub login says nothing about a
    Plane account, so the dev is the claim's; no claim, nobody. The `; …` the hook appends to its reason."""
    if ticket["assignees"]:
        return ""
    if not account:
        return "; unassigned, no claim names its dev"
    if not board.assign(ticket["number"], account):
        return f"; could not assign {account}"
    return f"; assigned {board.logins([account])[0]}"


def hook_push(board, payload):
    """Spec with a non-empty `## Acceptance criteria` pushed on a branch naming the ticket → grilled, from todo or
    grilling, and the grilling claim dropped. Anything else: no-op."""
    config = board.config
    if payload.get("deleted"):
        return {"action": "none", "reason": "branch deleted"}
    branch = payload.get("ref", "")[len("refs/heads/"):]
    keys = board.keys_in(branch)
    if not keys:
        return {"action": "none", "reason": f"{branch} names no {config['project_key']}-<n> ticket"}
    if len(keys) > 1:
        return {"action": "none", "reason": f"{branch} names several tickets ({', '.join(keys)})"}
    number, sha = keys[0], payload["after"]
    spec = spec_at(config, number, sha)
    if not spec:
        return {"ticket": number, "action": "none", "reason": f"no spec {config['specs_path']}/{number}*.md with acceptance criteria at {sha[:7]}"}
    path = spec[0]
    try:
        ticket = board.get(number)
    except Failure as failure:  # lb-ignore, unknown card: nothing to move
        return {"ticket": number, "action": "none", "reason": str(failure)}
    if ticket["state"] not in ("todo", "grilling"):
        where = ticket["state"] or f"column {ticket['column']!r}"
        return {"ticket": number, "action": "none", "reason": f"card in {where}, not todo/grilling"}
    board.set_state(ticket, "grilled")
    drop_claim(config, number, "grilling")
    # sha permalink: the branch is deleted on merge, the commit stays
    url = f"{server_url()}/{config['repo']}/blob/{sha}/{quote(path)}"
    board.comment(number, f"✅ **grilled** — spec [{path.rsplit('/', 1)[-1]}]({url}) on `{branch}`")
    return {"ticket": number, "action": f"{ticket['state']} → grilled", "reason": f"spec {path} at {sha[:7]}"}


def visible_text(body):
    """PR body as a reader sees it: no run report, HTML comments or code."""
    text = re.sub(r"<!-- wa-report -->[\s\S]*?<!-- /wa-report -->", "", body or "")
    text = re.sub(r"<!--[\s\S]*?-->", "", text)
    text = re.sub(r"```[\s\S]*?```", "", text)
    return re.sub(r"`[^`\n]*`", "", text)


def report_on_pr(config, pr, kind, text):
    """Contract break reported once on the PR, keyed by a hidden marker."""
    marker = f"<!-- board-check:{kind} -->"
    comments = rest("GET", f"repos/{config['repo']}/issues/{pr}/comments?per_page=100") or []
    if any(marker in (c.get("body") or "") for c in comments):
        return
    contract = f"{server_url()}/{config['repo']}/blob/HEAD/.lunabee/board/BOARD.md"
    body = f"{marker}\n⚠️ **board check** — {text}. See [BOARD.md]({contract}); this check only reports, it never moves cards."
    rest("POST", f"repos/{config['repo']}/issues/{pr}/comments", {"body": body})


def sprint_pr(config, pr):
    """A PR from a sprint branch lands a sprint, not a ticket."""
    return bool(config["sprint_prefix"]) and pr["head"]["ref"].startswith(config["sprint_prefix"])


def pr_tickets(board, pr):
    """(tickets, why) a PR names: the keys in its head branch, else in its title, else its card links in the body.
    The first source naming any wins. A sprint PR names none."""
    if sprint_pr(board.config, pr):
        return [], f"sprint PR ({pr['head']['ref']})"
    for source, text in (("branch", pr["head"]["ref"]), ("title", pr.get("title"))):
        found = board.keys_in(text)
        if found:
            return found, source
    return board.linked_tickets(visible_text(pr.get("body"))), "card link in body"


def pr_ticket(board, pr):
    """(ticket, why) of a PR, or (None, why). Several tickets → reported on the PR once, no ticket: a PR moves exactly
    one card."""
    found, why = pr_tickets(board, pr)
    if len(found) > 1:
        report_on_pr(board.config, pr["number"], "several-tickets",
                     f"#{pr['number']} names {', '.join(found)} ({why}): a PR moves exactly one ticket")
        return None, f"{why} names {', '.join(found)}: a PR moves exactly one ticket"
    if not found:
        if sprint_pr(board.config, pr):
            return None, why
        return None, f"{pr['head']['ref']} and the title name no {board.config['project_key']}-<n> ticket, the body links no card"
    return found[0], why


def feedback_rounds(text):
    """`### ` blocks of the spec's `## Feedback`: [(first line, last line, text)], 1-based. Feedback rounds are written
    there by whatever reviews the PR (whackagent's /wa-feedback, a human)."""
    lines = text.split("\n")
    start = next((i for i, line in enumerate(lines) if re.match(r"^## Feedback\s*$", line)), None)
    if start is None:
        return []
    rounds = []
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("## "):
            break
        if lines[i].startswith("### "):
            rounds.append([i + 1, i + 1])
        elif rounds and lines[i].strip():
            rounds[-1][1] = i + 1
    return [(a, b, "\n".join(lines[a - 1:b])) for a, b in rounds]


def new_feedback(config, number, before, after):
    """[(path, first, last, permalink)] of the spec's `## Feedback` rounds new since <before>; a force push that dropped
    <before> → the last round only."""
    spec = spec_at(config, number, after)
    rounds = feedback_rounds(spec[1]) if spec else []
    if not rounds:
        return []
    code, _ = rest("GET", f"repos/{config['repo']}/commits/{before}", check=False)
    if code != 0:
        rounds = rounds[-1:]
    else:
        previous = spec_at(config, number, before)
        old = {r[2] for r in feedback_rounds(previous[1])} if previous else set()
        rounds = [r for r in rounds if r[2] not in old]
    path = spec[0]
    return [(path, a, b, f"{server_url()}/{config['repo']}/blob/{after}/{quote(path)}?plain=1#L{a}-L{b}") for a, b, _ in rounds]


def run_report(body):
    """Run report of the PR body (between <!-- wa-report --> markers, as whackagent writes it), as plain Markdown for a
    card comment."""
    match = re.search(r"<!-- wa-report -->([\s\S]*?)<!-- /wa-report -->", body or "")
    if not match:
        return ""
    text = re.sub(r"<summary>(.*?)</summary>", r"**\1**\n", match.group(1))
    return re.sub(r"</?details>", "", text).strip()


def hook_pull_request(board, payload):
    """PR events → review / done / back:
    opened / reopened → review (drops coding + grilling claims) · edited → review when the card still sits in todo /
    grilled (ticket named late) · ready_for_review → ✅ comment, converted_to_draft → nothing · synchronize with a
    coding claim → review (end of a coding round), without one → nothing (claiming is optional) · review on an
    unassigned card → the round's claimer assigned · merged → done, every assignee removed, run report posted, sprint
    root closed when the sprint has no branch and its last ticket landed · sprint branch merged → sprint root closed ·
    closed unmerged → grilled when the head holds the spec, else todo, unless a coding claim or another open PR keeps
    the ticket going. Every
    event adds the PR as a link on the card. A column outside the six states is a human's: untouched, unless a coding
    claim proves a round is running. A replay moves nothing twice."""
    config = board.config
    pr = payload["pull_request"]
    action = payload.get("action")
    if (pr["head"].get("repo") or {}).get("full_name") != pr["base"]["repo"]["full_name"]:
        return {"action": "none", "reason": "pull request from a fork"}
    number, why = pr_ticket(board, pr)
    link = f"[#{pr['number']}]({pr['html_url']})"
    if number is None:
        prefix, head = config["sprint_prefix"], pr["head"]["ref"]
        if not (sprint_pr(config, pr) and action == "closed" and pr.get("merged")):
            return {"action": "none", "reason": why}
        name = head[len(prefix):]
        root = board.open_sprint(name)
        if not root:
            return {"action": "none", "reason": f"sprint branch {head} merged, no open sprint {name!r}"}
        board.close_sprint(root, f"{link} merged `{head}` into `{pr['base']['ref']}`")
        return {"ticket": root, "action": "sprint landed", "reason": f"#{pr['number']} merged {head}"}
    try:
        ticket = board.get(number)
    except Failure as failure:  # sprint root, lb-ignore, unknown card: nothing to move
        return {"ticket": number, "action": "none", "reason": str(failure)}
    linked = board.link_pr(number, pr["number"], pr["title"], pr["html_url"])
    found = f"#{pr['number']} → {number} by {why}" + (", PR linked on the card" if linked else "")
    none = lambda reason: {"ticket": number, "action": "none", "reason": f"{reason} ({found})"}
    state = ticket["state"]
    reclaimed = False
    if ticket["column"] and not state:
        reclaimed = action in ("opened", "reopened", "edited", "synchronize") and claim_held(config, number, "coding")
        if not reclaimed:
            return none(f"card in column {ticket['column']!r}, not a board state: untouched")
        state = "coding"
    draft = "draft " if pr.get("draft") else ""
    moved = lambda to, more="": {"ticket": number, "action": f"{state} → {to}", "reason": f"{action} ({found}){more}"}

    if action in ("opened", "reopened"):
        if state == "done":
            return none("card in done")
        developer = claimer(config, number, ("coding", "grilling"))
        drop_claim(config, number, "coding")
        drop_claim(config, number, "grilling")
        assigned = assign_developer(board, ticket, developer)
        if state == "review":  # replay, or a second PR: the card already says it
            return none(f"card already in review, claims dropped{assigned}")
        board.set_state(ticket, "review")
        board.comment(number, f"🔀 **review** — {draft}{link} → `{pr['base']['ref']}`")
        return moved("review", assigned)

    if action == "edited":
        # ticket named after `opened` (title or body edited): the board learns of the PR late. Never from `coding`:
        # a round may be running on a PR already known.
        if pr["state"] != "open" or not (reclaimed or state in ("todo", "grilled")):
            return none(f"edited, card in {state}")
        developer = claimer(config, number, ("coding",))
        board.set_state(ticket, "review")
        drop_claim(config, number, "coding")
        assigned = assign_developer(board, ticket, developer)
        board.comment(number, f"🔀 **review** — {draft}{link} → `{pr['base']['ref']}`")
        return moved("review", assigned)

    if action in ("ready_for_review", "converted_to_draft"):
        # draft ↔ ready changes who looks next, not the state. Never touches the claim.
        if action == "ready_for_review" and state != "done":
            board.comment(number, f"✅ **ready** — {link} ready to merge")
            return {"ticket": number, "action": "commented ready", "reason": found}
        return none(action)

    if action == "synchronize":
        if not claim_held(config, number, "coding"):
            return none("push without a coding claim: no round to end")
        after = payload["after"]
        developer = claimer(config, number, ("coding",))
        board.set_state(ticket, "review")
        drop_claim(config, number, "coding")
        assigned = assign_developer(board, ticket, developer)
        rounds = new_feedback(config, number, payload["before"], after)
        notes = "".join(f"\n\n[{p.rsplit('/', 1)[-1]} lines {a}–{b}]({url})" for p, a, b, url in rounds)
        board.comment(number, f"🔀 **review** — round {after[:7]} pushed to {link}{notes}")
        if rounds:
            permalinks = "".join(f"\n\n{url}" for *_, url in rounds)  # bare line permalink: GitHub embeds the snippet
            body = f"📝 **feedback** — round pushed for [{number}]({board.ticket_url(number)}){permalinks}"
            rest("POST", f"repos/{config['repo']}/issues/{pr['number']}/comments", {"body": body})
        return moved("review", assigned)

    if action == "closed" and pr.get("merged"):
        # mid-stack PR keeps its parent branch as base; a stack merge lands it on the stack base
        landed = ((pr.get("stack") or {}).get("base") or {}).get("ref") or pr["base"]["ref"]
        drop_claim(config, number, "grilling")
        drop_claim(config, number, "coding")
        # landed: nobody holds the ticket any more. Before the state, so a run that fails half-way and is rerun still
        # clears them
        removed = board.unassign_all(number)
        unassigned = f"; unassigned {', '.join(removed)}" if removed else ""
        result = none(f"card already in done{unassigned}")  # replay: the sprint check below still runs
        if state != "done":
            board.set_state(ticket, "done")
            report = run_report(pr.get("body"))
            board.comment(number, f"🎉 **done** — {link} merged into `{landed}`" + (f"\n\n{report}" if report else ""))
            result = moved("done", unassigned)
        # Sprint without branch: tickets land straight on the target, so the last one lands the sprint. With a branch,
        # they land in it and the sprint lands with the sprint branch PR (above).
        parent = board.sprint_parent(number)
        if parent and landed != config["sprint_prefix"] + parent[1] and board.sprint_complete(parent[0]):
            board.close_sprint(parent[0], f"last ticket {number} landed")
            result["reason"] += f"; sprint {parent[1]} landed ({parent[0]} → done)"
        return result

    if action == "closed":
        # another round is live (a coding claim, or another open PR for the ticket): this PR was superseded
        if state == "done":
            return none("closed unmerged, card in done")
        if claim_held(config, number, "coding"):
            return none("closed unmerged while a coding claim is held")
        for other in board.linked_prs(number):
            if other != pr["number"] and rest("GET", f"repos/{config['repo']}/pulls/{other}")["state"] == "open":
                return none(f"closed unmerged, #{other} still open for the ticket")
        back = "grilled" if spec_at(config, number, pr["head"]["sha"]) else "todo"
        if state == back:
            return none(f"closed unmerged, card in {state}")
        board.set_state(ticket, back)
        board.comment(number, f"↩️ **{back}** — {link} closed unmerged" + (", spec kept" if back == "grilled" else ""))
        return moved(back)

    return none(f"no rule for {action}")


HOOKS = {"push": hook_push, "pull_request": hook_pull_request}


def op_hook(args):
    event = args.event or os.environ.get("GITHUB_EVENT_NAME")
    source = args.payload or os.environ.get("GITHUB_EVENT_PATH")
    if not event or not source:
        raise Failure("no event: pass --event NAME --payload FILE", EXIT_USAGE)
    payload = json.loads(Path(source).read_text())
    handler = HOOKS.get(event)
    if handler:
        board = open_board()
        sent_for = (payload.get("repository") or {}).get("full_name")
        if sent_for and sent_for != board.config["repo"]:
            raise Failure(f"event is for {sent_for}, this board's repository is {board.config['repo']}", EXIT_USAGE)
        result = handler(board, payload)
    else:
        result = {"action": "none", "reason": f"no hook for {event}"}
    result = {"event": event, **result}
    note(f"hook {event}: {result['ticket'] + ' ' if 'ticket' in result else ''}{result['action']} — {result['reason']}")
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a") as out:
            ticket = f" `{result['ticket']}`" if "ticket" in result else ""
            out.write(f"**lb-board** · `{event}`{ticket}: {result['action']} — {result['reason']}\n")
    emit(result)


# ---------------------------------------------------------------- board check (report only)


def description_spec(markup):
    """Non-empty `## Acceptance criteria` of a Plane card description (HTML headings read as `## ` lines)."""
    return spec_section(text_of(re.sub(r"<h[1-6][^>]*>", "\n## ", markup or "", flags=re.I)), "Acceptance criteria")


def open_ticket_prs(board):
    """({ticket: {open PR numbers}}, {open PR numbers}): each open PR mapped like pr_ticket (one ticket named, else
    none), from the open PR list alone."""
    config = board.config
    tickets, numbers = {}, set()
    for page in itertools.count(1):
        prs = rest("GET", f"repos/{config['repo']}/pulls?state=open&per_page=100&page={page}") or []
        for pr in prs:
            numbers.add(pr["number"])
            found = pr_tickets(board, pr)[0]
            if len(found) == 1:
                tickets.setdefault(found[0], set()).add(pr["number"])
        if len(prs) < 100:
            return tickets, numbers


def board_check(board):
    """Each ticket card in a state but done or canceled, against the repository: `grilling` / `coding` with no claim
    of that phase, a claim with nothing new for PLANE_STALE_AFTER_HOURS, a linked PR merged while none is open and the
    card is not done, `review` with no open PR, an open PR while the card sits in `todo` / `grilled`, `grilled` with no
    spec on a branch naming it, acceptance criteria in the description while in `todo` (only a pushed spec moves it),
    in an open sprint's cycle without that sprint's root as parent (dropped there by hand: not in the sprint). Reports
    only: never writes a state or a comment. Sprint roots, lb-ignore cards and columns outside the six states are
    skipped."""
    config = board.config
    states = {i: s for s, i in config["state_ids"].items() if s in STATES}
    closed = {i for i, group in config["state_groups"].items() if group in PLANE_CLOSED_GROUPS}
    ignore = config["label_ids"].get(IGNORE_LABEL)
    active, open_sprints = [], {}
    for item in board.board_items():
        if board.is_root(item):
            if item["state"] not in closed:
                open_sprints.setdefault(sprint_name(item["name"]), board.key(item))
            continue
        state = states.get(item["state"])
        if state and state != "done" and ignore not in (item.get("labels") or []):
            active.append((board.key(item), state))
    held = claims(config)
    branches = ticket_branches(board)
    open_tickets, open_numbers = open_ticket_prs(board)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        links = dict(zip([key for key, _ in active], pool.map(lambda row: board.links(row[0]), active)))

    pulls = {}

    def merged(pr):
        if pr not in pulls:
            pulls[pr] = rest("GET", f"repos/{config['repo']}/pulls/{pr}")
        return bool(pulls[pr].get("merged_at"))

    hours = config["stale_after_hours"]
    now = dt.datetime.now(dt.timezone.utc)

    def stale(number, claim):
        """(agent, hours) of a claim with nothing new for `hours`: age = newest of claim and branch head commits."""
        fields = claim_fields(config, claim["sha"])
        dates = [fields["date"]] + [rest("GET", f"repos/{config['repo']}/git/commits/{sha}")["committer"]["date"]
                                    for sha in branches.get(number, {}).values()]
        age = int((now - dt.datetime.fromisoformat(max(dates).replace("Z", "+00:00"))).total_seconds() // 3600)
        return (fields.get("agent", "?"), age) if age >= hours else None

    found = []
    for key, state in active:
        problems = {}
        phases = [c["phase"] for c in held.get(key, [])]
        if state in ("grilling", "coding") and state not in phases:
            problems["lock-no-claim"] = f"card in `{state}` but nobody holds a {state} claim: claim it, or `release {key} {state} --reset-to <state>`"
        for claim in held.get(key, []):
            old = stale(key, claim)
            if old:
                phase = claim["phase"]
                ends = "pushes the spec or releases" if phase == "grilling" else "opens the PR or releases"
                problems[f"stale-{phase}"] = f"{phase} claim held by {old[0]}, nothing new for {old[1]} h: its holder {ends}, or a human runs `release {key} {phase} --reset-to <state>`"
        prs = board.linked_prs(key, links[key])
        is_open = key in open_tickets or any(pr in open_numbers for pr in prs)
        if not is_open and any(merged(pr) for pr in prs):
            problems["merged-not-done"] = f"a linked PR is merged but the card sits in `{state}`"
        if state == "review" and not is_open:
            problems["review-no-pr"] = "card in `review` but no open PR names this ticket"
        if state in ("todo", "grilled") and is_open:
            problems["pr-not-review"] = f"an open PR names this ticket but the card sits in `{state}`"
        if state == "grilled" and not any(spec_at(config, key, sha) for sha in branches.get(key, {}).values()):
            problems["grilled-no-spec"] = f"card in `grilled` but no branch naming {key} holds its spec `{config['specs_path']}/{key}-….md`"
        if state == "todo" and description_spec(board.items[key].get("description_html")):
            problems["spec-todo"] = "the card description holds acceptance criteria but the card sits in `todo`: only a spec file pushed on its branch moves it to `grilled`"
        stray = board.stray_sprint(key, open_sprints)
        if stray:
            root = open_sprints[stray]
            problems["cycle-no-parent"] = f"the card sits in cycle `{stray}` but its parent is not {root}, the sprint's root, so it is not in sprint `{stray}`: `set-field {key} sprint {stray}` to join, or take it out of the cycle"
        found += [{"ticket": key, "state": state, "kind": kind, "problem": text} for kind, text in problems.items()]
    return {"checked": len(active), "problems": found}


# ---------------------------------------------------------------- cli


def parser():
    p = argparse.ArgumentParser(prog="lb-board", description="Plane board of a GitHub repository (Lunabee)")
    sub = p.add_subparsers(dest="op", required=True)

    s = sub.add_parser("config", help="print resolved settings")
    s.set_defaults(func=op_config)

    s = sub.add_parser("list", help="board rows in priority order, with claims and open PRs")
    s.add_argument("--state", help="comma-separated states")
    s.add_argument("--mine", action="store_true", help="only cards assigned to me")
    s.add_argument("--sprint")
    s.add_argument("--milestone")
    s.add_argument("--all", action="store_true", help="include done and canceled")
    s.add_argument("--owners", action="store_true", help="resolve claim owners (one call per claim)")
    s.set_defaults(func=op_list)

    s = sub.add_parser("get", help="one ticket, with its branches, spec, linked PRs and blockers")
    s.add_argument("number", type=ticket_id)
    s.set_defaults(func=op_get)

    s = sub.add_parser("create", help="new card in todo")
    s.add_argument("--title", required=True)
    s.add_argument("--summary", required=True)
    s.add_argument("--note", help="more Markdown after the summary")
    s.add_argument("--priority", choices=PRIORITIES)
    s.add_argument("--assignee", help="workspace member display name")
    s.add_argument("--sprint", help="sprint name: the card becomes a child of its root, in its cycle")
    s.add_argument("--milestone", help='module title (default: highest open one that is not a track, "" = none)')
    s.set_defaults(func=op_create)

    s = sub.add_parser("claim", help="atomic lock and state move; exit 3 when taken, 4 when in the wrong state")
    s.add_argument("number", type=ticket_id)
    s.add_argument("phase", choices=sorted(CLAIM_FROM))
    s.add_argument("--agent", help="who holds it (default: LB_BOARD_AGENT, else host:repo path)")
    s.add_argument("--blocked-ok", action="store_true", help="coding despite an open blocker")
    s.set_defaults(func=op_claim)

    s = sub.add_parser("release", help="give a claim back")
    s.add_argument("number", type=ticket_id)
    s.add_argument("phase", choices=sorted(CLAIM_FROM))
    s.add_argument("--reset-to", choices=STATES)
    s.add_argument("--reason")
    s.set_defaults(func=op_release)

    s = sub.add_parser("cancel", help="close a ticket as not planned")
    s.add_argument("number", type=ticket_id)
    s.add_argument("--reason")
    s.set_defaults(func=op_cancel)

    s = sub.add_parser("move", help="priority: card order on the board")
    s.add_argument("number", type=ticket_id)
    where = s.add_mutually_exclusive_group(required=True)
    where.add_argument("--top", action="store_true")
    where.add_argument("--bottom", action="store_true")
    where.add_argument("--before", type=ticket_id)
    where.add_argument("--after", type=ticket_id)
    s.set_defaults(func=op_move)

    s = sub.add_parser("set-field", help="sprint or milestone of a ticket")
    s.add_argument("number", type=ticket_id)
    s.add_argument("field", choices=["sprint", "milestone"])
    s.add_argument("value", help='sprint name or module title ("" clears)')
    s.set_defaults(func=op_set_field)

    s = sub.add_parser("milestones", help="modules, highest first")
    s.set_defaults(func=op_milestones)

    s = sub.add_parser("close-milestone", help="close a shipped module")
    s.add_argument("title")
    s.set_defaults(func=op_close_milestone)

    s = sub.add_parser("split", help="ticket becomes the root of a sprint named after its title")
    s.add_argument("number", type=ticket_id)
    s.set_defaults(func=op_split)

    s = sub.add_parser("depend", help="ticket is blocked by others (Plane relations, add only)")
    s.add_argument("number", type=ticket_id)
    s.add_argument("--on", required=True, type=lambda v: [ticket_id(x) for x in v.split(",") if x], help="blocker keys, comma-separated")
    s.set_defaults(func=op_depend)

    s = sub.add_parser("comment")
    s.add_argument("number", type=ticket_id)
    text = s.add_mutually_exclusive_group(required=True)
    text.add_argument("text", nargs="?")
    text.add_argument("--body-file", help="read the text from a file, - = stdin")
    s.set_defaults(func=op_comment)

    s = sub.add_parser("link-pr", help="repair: link PR → card (the hooks link on their own)")
    s.add_argument("number", type=ticket_id)
    s.add_argument("pr", type=int)
    s.set_defaults(func=op_link_pr)

    s = sub.add_parser("claims", help="every live claim, owner, last activity, stale flag")
    s.set_defaults(func=op_claims)

    s = sub.add_parser("whoami")
    s.add_argument("--agent")
    s.set_defaults(func=op_whoami)

    s = sub.add_parser("check", help="report-only board check: cards against claims, branches, specs and PRs")
    s.set_defaults(func=op_check)

    s = sub.add_parser("provision", help="adopt or create a Plane project: states, labels, repo variables")
    s.add_argument("--plane-url", required=True, help="Plane server URL")
    s.add_argument("--workspace", required=True, help="workspace slug")
    s.add_argument("--project", required=True, help="project identifier (CUM) or id")
    s.add_argument("--create", metavar="NAME", help="create the project, named NAME, when no project has this identifier")
    s.add_argument("--state", action="append", metavar="STATE=NAME", help="adopt an existing state for a board state")
    s.add_argument("--prune-status", action="append", metavar="NAME", help="delete this extra state (kept while it holds cards)")
    s.add_argument("--specs-path", default="docs/specs")
    s.add_argument("--stale-after-hours", type=int, default=24)
    s.add_argument("--sprint-prefix", default="", help='sprint branch prefix, e.g. sprint/ ("" = sprints have no branch)')
    s.add_argument("--track", action="append", metavar="MODULE", help="module never picked as the default milestone")
    s.add_argument("--adopt-states", metavar="JSON", help="{state: id} of existing states to adopt (a board set up before)")
    s.add_argument("--rename-label", action="append", metavar="OLD=NEW", help="rename a label, cards keep it")
    s.set_defaults(func=op_provision)

    s = sub.add_parser("check-integration", help="is Plane's own GitHub integration off (single writer)?")
    s.add_argument("--plane-url", help="Plane server URL (default: PLANE_URL)")
    s.add_argument("--workspace", help="workspace slug (default: PLANE_WORKSPACE)")
    s.set_defaults(func=op_check_integration)

    s = sub.add_parser("hook", help="board hooks: one GitHub event (the webhook receiver runs it)")
    s.add_argument("--event", help="event name (default: GITHUB_EVENT_NAME)")
    s.add_argument("--payload", help="event payload JSON file (default: GITHUB_EVENT_PATH)")
    s.set_defaults(func=op_hook)
    return p


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        args.func(args)
    except Failure as failure:
        note(f"lb-board: {failure}")
        sys.exit(failure.code)


if __name__ == "__main__":
    main()
