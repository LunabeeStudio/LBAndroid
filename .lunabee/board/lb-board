def plane_call(url, method, path, body=None, missing=()):
    """(data, headers) of one /api/v1 call. HTTP 429 → sleep Retry-After, retry (bounded); `missing` codes → None."""
    key = os.environ.get(PLANE_KEY_ENV)
    if not key:
        raise Failure(f"{PLANE_KEY_ENV} not set — export the Plane API key in this shell (never in the repo or config)")
    request = urllib.request.Request(
        f"{url.rstrip('/')}/api/v1/{path.lstrip('/')}",
        data=json.dumps(body).encode() if body is not None else None,
        method=method,
        headers={"X-API-Key": key, "Content-Type": "application/json", "Accept": "application/json"},
    )
    for attempt in range(PLANE_TRIES):
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                raw = response.read()
                return (json.loads(raw) if raw else None), response.headers
        except urllib.error.HTTPError as error:
            raw = error.read()
            if error.code == 429 and attempt < PLANE_TRIES - 1:
                retry = error.headers.get("Retry-After") or ""
                wait = min(int(retry) if retry.isdigit() else 10, 60)
                note(f"Plane rate limit hit, retry in {wait}s — lift it: API_KEY_RATE_LIMIT=1000000/second on the server")
                time.sleep(wait)
                continue
            if error.code in missing:
                return None, error.headers
            try:
                reason = json.loads(raw)
                reason = reason.get("error") or reason.get("detail") or reason
            except ValueError:
                reason = raw.decode(errors="replace")[:200]
            raise Failure(f"Plane {method} {path}: HTTP {error.code} {reason}")
        except urllib.error.URLError as error:
            raise Failure(f"Plane unreachable at {url}: {error.reason}")
    raise Failure(f"Plane {method} {path}: still rate limited after {PLANE_TRIES} tries")


def plane_api(url, method, path, body=None, missing=()):
    return plane_call(url, method, path, body, missing)[0]


def plane_all(url, path):
    """Every row of a list endpoint: a bare list, or cursor pages of {results} (PLANE_PAGE rows each)."""
    rows, cursor = [], None
    sep = "&" if "?" in path else "?"
    while True:
        page = plane_api(url, "GET", f"{path}{sep}per_page={PLANE_PAGE}" + (f"&cursor={cursor}" if cursor else ""))
        if isinstance(page, list):
            return page
        rows += page.get("results", [])
        if not page.get("next_page_results"):
            return rows
        cursor = page["next_cursor"]


def plane_probe(url, path, key=None):
    """(HTTP status, JSON body or None) of one GET on any Plane route, outside /api/v1, no retry: 404 = no route."""
    headers = {"Accept": "application/json"}
    if key:
        headers["X-API-Key"] = key
    request = urllib.request.Request(f"{url.rstrip('/')}/{path.lstrip('/')}", headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            status, raw, kind = response.status, response.read(), response.headers.get("Content-Type") or ""
    except urllib.error.HTTPError as error:
        status, raw, kind = error.code, error.read(), error.headers.get("Content-Type") or ""
    except urllib.error.URLError as error:
        raise Failure(f"Plane unreachable at {url}: {error.reason}")
    if "json" not in kind:  # the web app answers unknown non-API paths with its HTML page
        return status, None
    try:
        return status, json.loads(raw) if raw else None
    except ValueError:
        return status, None


# Markdown → Plane HTML. Plane stores description_html / comment_html as sent, and its editor (TipTap) parses HTML
# only: Markdown sent as text shows its raw `##`, `**`, `[ ]`. plane_html renders the GitHub-flavored subset cards
# and comments use into the HTML Plane's editor writes itself. Raw HTML in the text stays text; HTML comment lines
# are dropped, as GitHub hides them.
MD_FENCE = re.compile(r" {0,3}(`{3,}|~{3,})[ \t]*([^\s`]*)[^`]*$")
MD_HEADING = re.compile(r" {0,3}(#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
MD_RULE = re.compile(r" {0,3}([-*_])(?:[ \t]*\1){2,}[ \t]*$")
MD_QUOTE = re.compile(r" {0,3}> ?(.*)")
MD_ITEM = re.compile(r"( *)([-*+]|\d{1,9}[.)])(?:[ \t]+(.*)|$)")
MD_TASK = re.compile(r"\[([ xX])\](?:[ \t]+(.*)|$)")
MD_TABLE_RULE = re.compile(r"\s*\|?\s*:?-+:?\s*(?:\|\s*:?-+:?\s*)*\|?\s*$")
MD_CODE = re.compile(r"(?<![`\\])(`+)(?!`)(.+?)(?<!`)\1(?!`)", re.S)
MD_ESCAPE = re.compile(r"\\([!-/:-@\[-`{-~])")
MD_AUTOLINK = re.compile(r"<((?:https?|mailto):[^\s<>]+)>", re.I)
MD_LINK = re.compile(r"!?\[((?:\\.|[^\[\]\\])*)\]\(\s*<?((?:[^\s()<>]|\([^\s()<>]*\))*)>?(?:\s+\"[^\"]*\")?\s*\)")
MD_URL = re.compile(r"\bhttps?://[^\s<>\x00]+", re.I)
MD_TOKEN = re.compile(r"\x00(\d+)\x00")
MD_MARKS = (
    (re.compile(r"\*\*(?=\S)(.+?)(?<=\S)\*\*", re.S), "strong"),
    (re.compile(r"(?<!\w)__(?=\S)(.+?)(?<=\S)__(?!\w)", re.S), "strong"),
    (re.compile(r"(?<!\*)\*(?=[^\s*])(.+?)(?<=[^\s*])\*(?!\*)", re.S), "em"),
    (re.compile(r"(?<![\w_])_(?=[^\s_])(.+?)(?<=[^\s_])_(?![\w_])", re.S), "em"),
    (re.compile(r"(?<!~)~~(?=\S)(.+?)(?<=\S)~~(?!~)", re.S), "s"),
)


def plane_html(markdown):
    """Markdown → Plane HTML, for description_html and comment_html."""
    lines = (markdown or "").replace("\r\n", "\n").expandtabs(4).split("\n")
    return "".join(md_blocks(lines)) or "<p></p>"


def md_blocks(lines):
    """Markdown lines → Plane HTML blocks."""
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        fence, heading = MD_FENCE.match(line), MD_HEADING.match(line)
        if not line.strip():
            i += 1
        elif line.lstrip().startswith("<!--"):
            while i < len(lines) and "-->" not in lines[i]:
                i += 1
            i += 1
        elif fence:
            indent = len(line) - len(line.lstrip(" "))
            close = re.compile(rf" {{0,3}}{re.escape(fence[1][0])}{{{len(fence[1])},}}[ \t]*$")
            body, i = [], i + 1
            while i < len(lines) and not close.match(lines[i]):
                body.append(re.sub(rf"^ {{0,{indent}}}", "", lines[i]))
                i += 1
            i += 1
            language = f' class="language-{html.escape(fence[2])}"' if fence[2] else ""
            out.append(f"<pre><code{language}>{html.escape(chr(10).join(body), quote=False)}</code></pre>")
        elif heading:
            level = len(heading[1])
            out.append(f"<h{level}>{md_inline(heading[2] or '')}</h{level}>")
            i += 1
        elif MD_RULE.match(line):
            out.append("<hr>")
            i += 1
        elif MD_QUOTE.match(line):
            body = []
            while i < len(lines) and MD_QUOTE.match(lines[i]):
                body.append(MD_QUOTE.match(lines[i])[1])
                i += 1
            out.append(f"<blockquote>{''.join(md_blocks(body)) or '<p></p>'}</blockquote>")
        elif MD_ITEM.match(line):
            markup, i = md_list(lines, i)
            out.append(markup)
        elif "|" in line and i + 1 < len(lines) and MD_TABLE_RULE.match(lines[i + 1]) \
                and len(md_cells(line)) == len(md_cells(lines[i + 1])):
            rows, i = [line], i + 2
            while i < len(lines) and "|" in lines[i] and lines[i].strip():
                rows.append(lines[i])
                i += 1
            out.append(md_table(rows))
        else:
            paragraph, i = [line.strip()], i + 1
            while i < len(lines) and lines[i].strip() and not md_interrupts(lines[i]):
                paragraph.append(lines[i].strip())
                i += 1
            text = "\n".join(re.sub(r"\\$", "", part) for part in paragraph)  # trailing `\` = hard break
            out.append(f"<p>{md_inline(text)}</p>")
    return out


def md_interrupts(line):
    """Whether a line starts a block that ends the paragraph above it (a list only when it has text and, numbered,
    starts at 1)."""
    item = MD_ITEM.match(line)
    return bool(MD_FENCE.match(line) or MD_HEADING.match(line) or MD_RULE.match(line) or MD_QUOTE.match(line)
                or line.lstrip().startswith("<!--")
                or item and item[3] and (not item[2][0].isdigit() or item[2][:-1] == "1"))


def md_list(lines, start):
    """(HTML, next line) of the list at lines[start]. An item owns the lines indented to its text (nested lists, code)
    and lazy paragraph lines right under it. Task items (`[ ]`, `[x]`) form Plane task lists."""
    first = MD_ITEM.match(lines[start])
    ordered, items, column, i = first[2][0].isdigit(), [], 0, start
    while i < len(lines):
        line = lines[i]
        indent, item = len(line) - len(line.lstrip(" ")), MD_ITEM.match(line)
        if item and (not items or indent < column):
            if item[2][0].isdigit() != ordered:
                break
            column = item.start(3) if item[3] is not None else len(item[0]) + 1
            items.append([item[3] or ""])
        elif not line.strip():
            items[-1].append("")
        elif indent >= column:
            items[-1].append(line[column:])
        elif items[-1][-1].strip() and not md_interrupts(line):
            items[-1].append(line.strip())
        else:
            break
        i += 1
    out, number = [], int(first[2][:-1]) if ordered else 1
    for task, group in itertools.groupby(items, key=lambda entry: bool(MD_TASK.match(entry[0]))):
        group = list(group)
        body = "".join(md_item(entry) for entry in group)
        if task:
            out.append(f'<ul data-type="taskList">{body}</ul>')
        elif ordered:
            out.append(f'<ol start="{number}">{body}</ol>' if number != 1 else f"<ol>{body}</ol>")
        else:
            out.append(f"<ul>{body}</ul>")
        number += len(group)
    return "".join(out), i


def md_item(lines):
    """One list item → <li>, a Plane task item when it opens with `[ ]` / `[x]`. Plane wants a paragraph first."""
    task = MD_TASK.match(lines[0])
    if task:
        lines = [task[2] or ""] + lines[1:]
    body = "".join(md_blocks(lines))
    if not body.startswith("<p>"):
        body = "<p></p>" + body
    if not task:
        return f"<li>{body}</li>"
    checked = task[1] != " "
    box = '<input type="checkbox" checked>' if checked else '<input type="checkbox">'
    return f'<li data-checked="{"true" if checked else "false"}" data-type="taskItem"><label>{box}<span></span></label><div>{body}</div></li>'


def md_cells(row):
    row = row.strip()
    row = row[1:] if row.startswith("|") else row
    row = row[:-1] if row.endswith("|") and not row.endswith("\\|") else row
    return [cell.strip() for cell in re.split(r"(?<!\\)\|", row)]


def md_table(rows):
    """GFM pipe table → Plane table: first row as header cells, each cell one paragraph."""
    width = len(md_cells(rows[0]))

    def row(line, tag):
        cells = (md_cells(line) + [""] * width)[:width]
        return "<tr>" + "".join(f"<{tag}><p>{md_inline(cell)}</p></{tag}>" for cell in cells) + "</tr>"

    return f"<table><tbody>{row(rows[0], 'th')}{''.join(row(line, 'td') for line in rows[1:])}</tbody></table>"


def md_marks(text):
    """Escaped text with **strong**, *em* / _em_ and ~~strike~~ marks."""
    text = html.escape(text, quote=False)
    for pattern, tag in MD_MARKS:
        text = pattern.sub(rf"<{tag}>\1</{tag}>", text)
    return text


def md_inline(text):
    """One paragraph's inline Markdown → HTML, line breaks as <br>. Code, escapes and links are set aside as tokens
    first, so emphasis never reaches into them. Code inside a link shows as plain text: Plane's inline code mark
    excludes every other mark, the link included. Images show as links (Plane hosts its own images only)."""
    tokens = []

    def keep(markup):
        tokens.append(markup)
        return f"\x00{len(tokens) - 1}\x00"

    def anchor(url, label):
        return keep(f'<a href="{html.escape(url)}">{label}</a>')

    def code(match):
        body = match[2].replace("\n", " ")
        if body.strip() and body[0] == body[-1] == " ":
            body = body[1:-1]
        return keep(f"<code>{html.escape(body, quote=False)}</code>")

    def link(match):
        url = match[2]
        if re.match(r"[a-z][a-z0-9+.-]*:", url, re.I) and not re.match(r"(?:https?|mailto):", url, re.I):
            return match[0]  # javascript: and other schemes stay text
        return anchor(url, md_marks(match[1]) or html.escape(url, quote=False))

    def bare(match):
        url = match[0]
        while url[-1] in ".,:;!?'\"*_~" or url[-1] == ")" and url.count(")") > url.count("("):
            url = url[:-1]
        return anchor(url, html.escape(url, quote=False)) + match[0][len(url):]

    text = MD_CODE.sub(code, text.replace("\x00", ""))
    text = MD_ESCAPE.sub(lambda match: keep(html.escape(match[1])), text)
    text = MD_AUTOLINK.sub(lambda match: anchor(match[1], html.escape(match[1], quote=False)), text)
    text = md_marks(MD_URL.sub(bare, MD_LINK.sub(link, text)))
    while MD_TOKEN.search(text):
        text = MD_TOKEN.sub(lambda match: tokens[int(match[1])], text)
    text = re.sub(r"<a [^>]*>.*?</a>", lambda match: re.sub(r"</?code>", "", match[0]), text, flags=re.S)
    return text.replace("\n", "<br>")


def text_of(markup):
    """Plane description → plain text, one line per block."""
    text = re.sub(r"<br\s*/?>|</(?:p|div|li|h\d|pre|blockquote)>", "\n", markup or "", flags=re.I)
    return html.unescape(re.sub(r"<[^>]+>", "", text))


def ensure_plane_states(url, base, names, prune, adopt=None, fresh=False):
    """Make the project carry the seven states (six contract states + canceled) in their Plane groups, in board
    order, Todo the default. Adopts a state by name (`names` overrides, else default name, then Plane's seed
    alias), creates the missing ones. `adopt` ({state: id}, a board set up before, e.g. by whackagent) wins over
    names. Never renames or deletes a state on its own: extra columns stay and are reported; `prune` names extras
    to delete, and one still holding cards stays (Plane refuses). `fresh` (a project provision --create made) deletes
    every extra: Plane's seed columns (Backlog, In Progress), empty unless a card landed there since. Returns ({state: id}, report)."""
    path = f"{base}/states/"
    have = plane_all(url, path)
    by_name = {s["name"]: s for s in have}
    by_id = {s["id"]: s for s in have}
    report = {"created": [], "updated": [], "removed": [], "extra": [], "held": {}, "default_changed": False}
    ids = {}
    for index, (state, (default_name, group, color)) in enumerate(PLANE_STATES.items(), 1):
        name = names.get(state, default_name)
        found = by_id.get((adopt or {}).get(state)) or by_name.get(name)
        if not found and state not in names:
            found = next((by_name[a] for a in PLANE_STATE_ALIASES.get(state, []) if a in by_name), None)
        want = {"group": group, "sequence": index * 10000}
        if not found:
            # POST ignores `sequence` (appends at the end): the PATCH below puts it in place.
            found = plane_api(url, "POST", path, {"name": name, "color": color, **want})
            report["created"].append(name)
        changes = {k: v for k, v in want.items() if found.get(k) != v}
        if changes:
            found = plane_api(url, "PATCH", f"{path}{found['id']}/", changes)
            if found["name"] not in report["created"]:
                report["updated"].append(found["name"])
        ids[state] = found["id"]
    # A card created in the Plane UI without a state lands in the default one: todo. PATCH default=true does not
    # clear the previous default (Plane 1.4.2 bug), so every other default is cleared by hand.
    current = {s["id"]: s for s in plane_all(url, path)}
    if not current[ids["todo"]].get("default"):
        plane_api(url, "PATCH", f"{path}{ids['todo']}/", {"default": True})
        report["default_changed"] = True
    for state in current.values():
        if state["id"] != ids["todo"] and state.get("default"):
            plane_api(url, "PATCH", f"{path}{state['id']}/", {"default": False})
            report["default_changed"] = True
    extras = [s for s in current.values() if s["id"] not in ids.values()]
    named = set(prune or [])
    ours = {current[i]["name"] for i in ids.values()}
    if named & ours:
        raise Failure(f"--prune-status names a state column: {sorted(named & ours)}", EXIT_USAGE)
    doomed = [s for s in extras if fresh or s["name"] in named]
    for state in doomed:
        plane_api(url, "DELETE", f"{path}{state['id']}/", missing=(400,))  # 400: not empty, Plane keeps it
    left = {s["id"] for s in plane_all(url, path)} if doomed else set()
    report["removed"] = [s["name"] for s in doomed if s["id"] not in left]
    held_ids = [s["id"] for s in doomed if s["id"] in left]
    if held_ids:
        project_key = plane_api(url, "GET", f"{base}/")["identifier"]
        for item in plane_all(url, f"{base}/work-items/"):
            if item["state"] in held_ids:
                report["held"].setdefault(current[item["state"]]["name"], []).append(f"{project_key}-{item['sequence_id']}")
    report["extra"] = [s["name"] for s in sorted(extras, key=lambda s: s["sequence"]) if s["name"] not in report["removed"]]
    return ids, report


def ensure_plane_labels(url, base):
    """Labels the board reads: lb-ignore (a card that is not a ticket), lb-sprint (sprint root). Returns created names."""
    have = {l["name"] for l in plane_all(url, f"{base}/labels/")}
    created = []
    for name, color in PLANE_LABELS.items():
        if name not in have:
            plane_api(url, "POST", f"{base}/labels/", {"name": name, "color": color}, missing=(409,))
            created.append(name)
    return created


def rename_labels(url, base, pairs):
    """OLD=NEW label renames (a board taken over from another tool, e.g. whackagent's wa-ignore / wa-sprint): a PATCH of
    the label's name, so every card keeps it. Skipped when OLD is gone, or when NEW exists and a card carries it. An
    empty NEW is deleted first: a provision run before the rename (the takeover's setup PR) already created it.
    Returns the renames done."""
    labels = {l["name"]: l for l in plane_all(url, f"{base}/labels/")}
    used = None
    done = []
    for pair in pairs:
        old, _, new = pair.partition("=")
        if old not in labels:
            continue
        if new in labels:
            if used is None:
                used = {label for item in plane_all(url, f"{base}/work-items/") for label in item.get("labels") or []}
            if labels[new]["id"] in used:
                continue
            plane_api(url, "DELETE", f"{base}/labels/{labels[new]['id']}/")
        plane_api(url, "PATCH", f"{base}/labels/{labels[old]['id']}/", {"name": new})
        done.append(pair)
    return done


# ---------------------------------------------------------------- ticket keys


def keys_in(text, key):
    """Ticket keys of project <key> named anywhere in <text>, upper-cased, first seen first: `feature/cum-12-login`
    → ["CUM-12"]. A key glued to a letter or digit (`XCUM-12`, `CUM-123` for CUM-12) is another word."""
    pattern = re.compile(rf"(?<![A-Za-z0-9]){re.escape(key)}-(\d+)(?!\d)", re.I)
    return list(dict.fromkeys(f"{key}-{int(m.group(1))}" for m in pattern.finditer(text or "")))


def ticket_id(text):
    """Ticket id from the command line: a key "CUM-12", any case."""
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9]{0,11}-\d+", text):
        raise argparse.ArgumentTypeError(f"not a ticket key like CUM-12: {text!r}")
    return text.upper()


# ---------------------------------------------------------------- Plane board


class Board:
    """Plane CE project: ticket = work item, id = its key "CUM-12", state = Plane state (ids in PLANE_STATES, plus
    Canceled), priority order = sort_order, excluded = label lb-ignore, blocked by = relation blocked_by, sprint =
    parent work item labeled lb-sprint (the truth) mirrored by a cycle of the same name (Plane's sprint view),
    milestone = module (one per ticket, the board enforces it). Pull request = work-item link (the hooks add it). Account = the Plane user owning the API key (shown by display name,
    compared by id), not the GitHub login that writes claim refs, branches and PRs."""

    def __init__(self, config):
        self.config = config
        self.items = {}  # key → work item read this run
        self.by_id = {}  # id → work item read this run (a child's parent is an id)
        self.members = None
        self.module_rows = None  # modules (milestones) of the project, read once per run
        self.module_items = None  # module id → ids of its work items, read once per run
        self.cycle_items = None  # cycle id → (sprint name, ids of its work items), read once per run

    @classmethod
    def settings(cls, repo, variables):
        needed = ["PLANE_URL", "PLANE_WORKSPACE", "PLANE_PROJECT_ID", "PLANE_STATES"]
        missing = [v for v in needed if v not in variables]
        if missing:
            raise Failure(f"{repo} has no {', '.join(missing)} variable — set the board up first (/lb-board-setup)")
        url, slug, project_id = variables["PLANE_URL"].rstrip("/"), variables["PLANE_WORKSPACE"], variables["PLANE_PROJECT_ID"]
        base = f"workspaces/{slug}/projects/{project_id}"
        project = plane_api(url, "GET", f"{base}/")
        states = plane_all(url, f"{base}/states/")
        labels = plane_all(url, f"{base}/labels/")
        state_ids = json.loads(variables["PLANE_STATES"])
        known = {s["id"] for s in states}
        lost = [s for s in PLANE_STATES if state_ids.get(s) not in known]
        if lost:
            raise Failure(f"Plane states missing for {lost} — run provision again")
        return {
            "plane_url": url,
            "workspace": slug,
            "project_id": project_id,
            "project_key": project["identifier"],
            "project_url": f"{url}/{slug}/projects/{project_id}/issues/",
            "state_ids": {s: state_ids[s] for s in PLANE_STATES},
            "state_names": {s["id"]: s["name"] for s in states},  # every column, extras included
            "state_groups": {s["id"]: s["group"] for s in states},
            "label_ids": {l["name"]: l["id"] for l in labels if l["name"] in PLANE_LABELS},
        }

    def base(self):
        return f"workspaces/{self.config['workspace']}/projects/{self.config['project_id']}"

    def api(self, method, path, body=None, missing=()):
        return plane_api(self.config["plane_url"], method, path, body, missing)

    # ------------------------------------------------ reading

    def key(self, item):
        return f"{self.config['project_key']}-{item['sequence_id']}"

    def remember(self, item):
        self.items[self.key(item)] = item
        self.by_id[item["id"]] = item
        return item

    def keys_in(self, text):
        return keys_in(text, self.config["project_key"])

    def member_names(self):
        """{user id: display name} of the workspace, read once per run."""
        if self.members is None:
            rows = self.api("GET", f"workspaces/{self.config['workspace']}/members/")
            self.members = {m["id"]: m["display_name"] for m in (rows or [])}
        return self.members

    def logins(self, ids):
        return [self.member_names().get(i, i) for i in ids] if ids else []

    def to_ticket(self, item):
        config = self.config
        state_id = item["state"]
        state = {i: s for s, i in config["state_ids"].items()}.get(state_id)
        group = config["state_groups"].get(state_id)
        key = self.key(item)
        self.remember(item)
        return {
            "number": key,
            "title": item["name"],
            "summary": summary_of(text_of(item.get("description_html"))),
            "state": state if state in STATES else None,  # canceled: no contract state, closed + not_planned
            "column": config["state_names"].get(state_id, "?"),
            "priority": item.get("priority") or "none",
            "size": None,  # Plane CE can't create estimates over its API: no size
            "sprint": self.sprint_of(item),
            "milestone": self.milestone_of(item),
            "closed": group in PLANE_CLOSED_GROUPS,
            "not_planned": group == "cancelled",
            # lb-ignore cards and sprint roots are not tickets
            "ignored": bool(set(item.get("labels") or []) & set(config["label_ids"].values())),
            "assignees": self.logins(item.get("assignees") or []),
            # Assigned to someone else: a human reserved it, nobody else may claim it. Compared by user id: display
            # names are not unique.
            "reserved": bool(item.get("assignees")) and self.user()["id"] not in item["assignees"],
            "mine": self.user()["id"] in (item.get("assignees") or []),
            "claims": [],  # filled by with_claims, here so the key keeps its place in the output
            "url": self.ticket_url(key),
            "item_id": item["id"],
        }

    def board_items(self):
        """Every card of the board, priority order (sort_order, lower = higher), drafts and archived cards left out.
        Sprint roots too: rows name their sprint without another call."""
        items = plane_all(self.config["plane_url"], f"{self.base()}/work-items/?order_by=sort_order")
        items = sorted((i for i in items if not i.get("is_draft") and not i.get("archived_at")), key=lambda i: i["sort_order"])
        return [self.remember(i) for i in items]

    def tickets(self):
        return [self.to_ticket(i) for i in self.board_items()]

    def item(self, number):
        if number in self.items:
            return self.items[number]
        key = self.config["project_key"]
        if number.rsplit("-", 1)[0] != key:
            raise Failure(f"{number} is not on this board: its tickets are {key}-<n>", EXIT_USAGE)
        item = self.api("GET", f"workspaces/{self.config['workspace']}/work-items/{number}/", missing=(404,))
        if not item or item.get("project") != self.config["project_id"]:
            raise Failure(f"{number} does not exist")
        return self.remember(item)

    def get(self, number):
        ticket = self.to_ticket(self.item(number))
        if self.is_root(self.items[number]):
            raise Failure(f"{number} is sprint {ticket['title']!r}, not a ticket", EXIT_WRONG_STATE)
        if ticket["ignored"]:
            raise Failure(f"{number} is labeled {IGNORE_LABEL}, not a ticket", EXIT_WRONG_STATE)
        return ticket

    def blocked_by(self, number):
        relations = self.api("GET", f"{self.base()}/work-items/{self.item(number)['id']}/relations/", missing=(404,)) or {}
        rows = []
        for blocker in relations.get("blocked_by", []):
            if blocker["project_id"] != self.config["project_id"]:
                continue  # another project's card: not a ticket of this board
            item = self.api("GET", f"{self.base()}/work-items/{blocker['issue_id']}/")
            group = self.config["state_groups"].get(item["state"])
            rows.append({"number": self.key(item), "state": "closed" if group in PLANE_CLOSED_GROUPS else "open"})
        return rows

    @functools.lru_cache(maxsize=None)
    def user(self):
        """Plane user owning the API key: the account a claim assigns and `reserved` compares against."""
        return self.api("GET", "users/me/")

    def me(self):
        return self.user()["display_name"]

    def account(self):
        return self.user()["id"]

    def member_id(self, login):
        """User id of <login>: a display name (the key's user first: names are not unique), or already an id."""
        if login == self.me():
            return self.user()["id"]
        if login in self.member_names():
            return login
        return next((i for i, name in self.member_names().items() if name == login), None)

    def ticket_url(self, number):
        return f"{self.config['plane_url']}/{self.config['workspace']}/browse/{number}/"

    def linked_tickets(self, text):
        """Keys of this board's card links (ticket_url shape) in <text>, first seen first: scheme, case and the
        trailing slash ignored, another workspace's or project's cards left out."""
        host = re.sub(r"^https?://", "", self.config["plane_url"])
        key = self.config["project_key"]
        pattern = re.compile(rf"https?://{re.escape(host)}/{re.escape(self.config['workspace'])}/browse/({re.escape(key)}-\d+)(?!\d)", re.I)
        return list(dict.fromkeys(m.group(1).upper() for m in pattern.finditer(text or "")))

    # ------------------------------------------------ writing

    def set_state(self, ticket, state):
        """Card to the state's column, priority kept: sort_order sent unchanged with the state, so a Plane release
        that repositions on state change can't reorder the board behind us."""
        item = self.item(ticket["number"])
        self.remember(self.api("PATCH", f"{self.base()}/work-items/{item['id']}/", {
            "state": self.config["state_ids"][state], "sort_order": item["sort_order"],
        }))

    def set_assignees(self, number, change):
        """Read the assignee ids fresh (a human may have just assigned someone), PATCH the changed list (Plane
        replaces it whole). Returns the ids Plane stored."""
        item = self.api("GET", f"{self.base()}/work-items/{self.item(number)['id']}/")
        ids = change(list(item.get("assignees") or []))
        if ids == item.get("assignees"):
            return ids
        stored = self.remember(self.api("PATCH", f"{self.base()}/work-items/{item['id']}/", {"assignees": ids}))
        return stored.get("assignees") or []

    def assign(self, number, login):
        user = self.member_id(login)
        if not user:
            return False
        try:
            return user in self.set_assignees(number, lambda ids: ids if user in ids else ids + [user])
        except Failure:
            return False

    def unassign(self, number, login):
        user = self.member_id(login)
        if user:
            self.set_assignees(number, lambda ids: [i for i in ids if i != user])

    def unassign_all(self, number):
        """Every assignee removed (hooks: the ticket landed). Returns the display names removed."""
        removed = []
        self.set_assignees(number, lambda ids: removed.extend(ids) or [])
        return self.logins(removed)

    def comment(self, number, text):
        self.api("POST", f"{self.base()}/work-items/{self.item(number)['id']}/comments/", {"comment_html": plane_html(text)})

    def create(self, title, body, priority=None, assignee=None, milestone=None, sprint=None):
        """New card in todo (Plane puts it at the bottom of that column). No milestone given: the highest open module,
        so new work lands in the scope being planned, never in the current or a past one; "" = none. Resolved first:
        a bad title creates nothing. Returns {number, url, milestone}."""
        module = self.latest_module() if milestone is None else self.module(milestone)
        fields = {"name": title, "description_html": plane_html(body), "state": self.config["state_ids"]["todo"]}
        if priority:
            fields["priority"] = priority
        if assignee:
            user = self.member_id(assignee)
            if not user:
                raise Failure(f"no workspace member named {assignee!r}", EXIT_USAGE)
            fields["assignees"] = [user]
        item = self.remember(self.api("POST", f"{self.base()}/work-items/", fields))
        key = self.key(item)
        if module:
            self.api("POST", f"{self.base()}/modules/{module['id']}/module-issues/", {"issues": [item["id"]]})
        if sprint:
            self.set_sprint(key, sprint)
        return {"number": key, "url": self.ticket_url(key), "milestone": module["title"] if module else None}

    # ------------------------------------------------ priority and dependencies

    def set_order(self, item, value):
        self.api("PATCH", f"{self.base()}/work-items/{item['id']}/", {"sort_order": value})

    def move(self, number, before=None, after=None, bottom=False):
        """Priority = sort_order over the whole board, the order `list` reads: one PATCH, the value the web UI
        would write for that drop (top: first − 65535, bottom: last + 65535, between: midpoint). A gap too
        small for a midpoint respaces the cards around it first (respace)."""
        items = self.board_items()
        keys = [self.key(i) for i in items]
        for n in filter(None, [number, before, after]):
            if n not in keys:
                raise Failure(f"{n} is not on the board", EXIT_USAGE)
        if number in (before, after):
            raise Failure(f"{number} cannot move relative to itself", EXIT_USAGE)
        card = items[keys.index(number)]
        order = [i for i in items if i is not card]
        rest_keys = [self.key(i) for i in order]
        if bottom:
            at = len(order)
        elif after:
            at = rest_keys.index(after) + 1
        elif before:
            at = rest_keys.index(before)
        else:
            at = 0
        low = order[at - 1]["sort_order"] if at > 0 else None
        high = order[at]["sort_order"] if at < len(order) else None
        if low is None and high is None:
            return  # alone on the board
        if low is None:
            value = high - PLANE_STEP
        elif high is None:
            value = low + PLANE_STEP
        elif high - low > PLANE_MIN_GAP:
            value = (low + high) / 2
        else:
            value = self.respace(order, at, number)
        self.set_order(card, value)

    def respace(self, order, at, number):
        """Cards crowded around slot `at` (gap under PLANE_MIN_GAP, after ~50 midpoints in one place): widen a
        window around the slot until its cards plus the moved one fit PLANE_MIN_STEP apart between the window's
        two outer cards (past the board's ends: first − 65535 / last + 65535), PATCH the cards inside, return
        the moved card's value. Only the crowded cluster is written, never the whole board."""
        def edge(i):
            if i < 0:
                return order[0]["sort_order"] - PLANE_STEP
            if i >= len(order):
                return order[-1]["sort_order"] + PLANE_STEP
            return order[i]["sort_order"]

        low, high = at - 1, at  # outer cards, kept; the cards strictly between them move
        while True:
            step = (edge(high) - edge(low)) / (high - low + 1)
            if step >= PLANE_MIN_STEP or (low < 0 and high >= len(order)):
                break
            low, high = max(low - 1, -1), min(high + 1, len(order))
        inside = order[low + 1:high]
        slots = inside[:at - low - 1] + [None] + inside[at - low - 1:]
        value = None
        for index, item in enumerate(slots, 1):
            target = edge(low) + step * index
            if item is None:
                value = target
            else:
                self.set_order(item, target)
        note(f"respaced {len(inside)} card(s) around {number}: sort_order gap was under {PLANE_MIN_GAP}")
        return value

    def depend(self, number, blockers):
        """Relations `blocked_by` (Plane shows them on both cards). Plane stores a relation once, so posting it again
        is harmless; read first anyway to tell added from already there. No API route removes one: the Plane UI does."""
        blockers = list(dict.fromkeys(blockers))
        if number in blockers:
            raise Failure(f"{number} cannot block itself", EXIT_USAGE)
        item = self.item(number)
        ids = {b: self.item(b)["id"] for b in blockers}  # each blocker exists on this board, or exit
        path = f"{self.base()}/work-items/{item['id']}/relations/"
        have = {r["issue_id"] for r in (self.api("GET", path, missing=(404,)) or {}).get("blocked_by", [])}
        added = [b for b in blockers if ids[b] not in have]
        if added:
            self.api("POST", path, {"relation_type": "blocked_by", "issues": [ids[b] for b in added]})
        return added, [b for b in blockers if ids[b] in have]

    # ------------------------------------------------ milestones (modules)

    def modules(self):
        """Milestones = modules, archived ones left out, read once per run: [{id, title, open, tickets, done, number}].
        `number` = creation time, the tie-break milestone_rank uses."""
        if self.module_rows is None:
            self.module_rows = [
                {
                    "id": m["id"],
                    "title": m["name"],
                    "open": m.get("status") not in PLANE_CLOSED_MODULE,
                    "tickets": m.get("total_issues") or 0,
                    "done": (m.get("completed_issues") or 0) + (m.get("cancelled_issues") or 0),
                    "number": m.get("created_at") or "",
                }
                for m in plane_all(self.config["plane_url"], f"{self.base()}/modules/")
                if not m.get("archived_at")
            ]
        return self.module_rows

    def module_members(self):
        """{module id: work item ids}, read once per run: one call per module holding cards (empty ones skipped,
        `?fields=id` keeps rows small), in parallel. No work item field names its modules."""
        if self.module_items is None:
            held = [m for m in self.modules() if m["tickets"]]
            url = self.config["plane_url"]
            ids = lambda m: {i["id"] for i in plane_all(url, f"{self.base()}/modules/{m['id']}/module-issues/?fields=id")}
            with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
                self.module_items = dict(zip([m["id"] for m in held], pool.map(ids, held)))
        return self.module_items

    def modules_of(self, item_id):
        members = self.module_members()
        return [m for m in self.modules() if item_id in members.get(m["id"], ())]

    def milestone_of(self, item):
        """The card's module. One per ticket (set_milestone enforces it); a card a human put in several shows the highest."""
        held = self.modules_of(item["id"])
        return max(held, key=milestone_rank)["title"] if held else None

    def latest_module(self):
        """Highest open module (milestone_rank), or None. Tracks (PLANE_TRACKS) never: new work lands on base, joining
        a track is a human's call."""
        tracks = set(self.config.get("tracks", []))
        opened = [m for m in self.modules() if m["open"] and m["title"] not in tracks]
        return max(opened, key=milestone_rank) if opened else None

    def module(self, title):
        """Modules are made and closed by humans in Plane: an unknown title is an error, never created. "" = none."""
        if not title:
            return None
        found = [m for m in self.modules() if m["title"] == title]
        if not found:
            raise Failure(f"no milestone {title!r} — create the module in Plane first", EXIT_USAGE)
        return found[0]

    def milestones(self):
        """Open modules highest first, then closed ones still holding open cards."""
        highest_first = lambda ms: sorted(ms, key=milestone_rank, reverse=True)
        rows = highest_first([m for m in self.modules() if m["open"]])
        rows += [m for m in highest_first([m for m in self.modules() if not m["open"]]) if m["tickets"] > m["done"]]
        return [{"title": m["title"], "open": m["open"], "tickets": m["tickets"], "done": m["done"]} for m in rows]

    def close_milestone(self, title):
        """Module status → completed (Plane CE's closed status; archive stays a human's call)."""
        module = self.module(title)
        if module is None:
            raise Failure("milestone title required", EXIT_USAGE)
        self.api("PATCH", f"{self.base()}/modules/{module['id']}/", {"status": "completed"})

    def set_milestone(self, number, title):
        """Card into that module and out of every other: Plane lets a work item sit in several, a ticket has one."""
        target = self.module(title)
        item_id = self.item(number)["id"]
        base = self.base()
        for module in self.modules_of(item_id):
            if not target or module["id"] != target["id"]:
                self.api("DELETE", f"{base}/modules/{module['id']}/module-issues/{item_id}/", missing=(404,))
        if target and item_id not in self.module_members().get(target["id"], ()):
            self.api("POST", f"{base}/modules/{target['id']}/module-issues/", {"issues": [item_id]})

    # ------------------------------------------------ sprints (parent work item + cycle)

    def sprint_label(self):
        label = self.config["label_ids"].get(SPRINT_LABEL)
        if not label:
            raise Failure(f"no {SPRINT_LABEL} label on the Plane project — run provision again")
        return label

    def is_root(self, item):
        """Sprint root: a work item labeled lb-sprint, not a ticket."""
        return self.config["label_ids"].get(SPRINT_LABEL) in (item.get("labels") or [])

    def parent_of(self, item):
        """The card's parent work item, None without one: from this run's reads (`list` holds every card), else one call."""
        parent = item.get("parent")
        if not parent:
            return None
        if parent not in self.by_id:
            self.remember(self.api("GET", f"{self.base()}/work-items/{parent}/"))
        return self.by_id[parent]

    def sprint_of(self, item):
        """Sprint = kebab-case name of the lb-sprint parent. The parent is the truth, the cycle mirrors it."""
        parent = self.parent_of(item)
        return sprint_name(parent["name"]) if parent and self.is_root(parent) else None

    def sprint_roots(self, name):
        return [i for i in self.board_items() if self.is_root(i) and sprint_name(i["name"]) == name]

    def find_cycle(self, name):
        cycles = plane_all(self.config["plane_url"], f"{self.base()}/cycles/")
        return next((c["id"] for c in cycles if sprint_name(c["name"]) == name), None)

    def sprint_cycle(self, name):
        """Id of cycle <name>, Plane's view of the sprint, created on first use. No dates: Plane takes both or
        none, and a dateless (draft) cycle never ends, so it always takes cards."""
        found = self.find_cycle(name)
        if found:
            return found
        return self.api("POST", f"{self.base()}/cycles/", {"name": name, "project_id": self.config["project_id"]})["id"]

    def cycle_members(self):
        """{cycle id: (sprint name, work item ids)}, read once per run: one call per cycle holding cards, in parallel.
        No work item field names its cycle."""
        if self.cycle_items is None:
            url = self.config["plane_url"]
            held = [c for c in plane_all(url, f"{self.base()}/cycles/") if c.get("total_issues", 1)]
            ids = lambda c: {i["id"] for i in plane_all(url, f"{self.base()}/cycles/{c['id']}/cycle-issues/?fields=id")}
            with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
                self.cycle_items = {c["id"]: (sprint_name(c["name"]), members) for c, members in zip(held, pool.map(ids, held))}
        return self.cycle_items

    def stray_sprint(self, number, open_sprints=None):
        """Open sprint whose cycle holds the card while its parent is not that sprint's root: a human dropped it in the
        cycle by hand. The parent decides, so the card is not in that sprint. <open_sprints>: {name: root key} of the
        open sprints when the caller read the board, else looked up here."""
        item = self.item(number)
        name = next((n for n, members in self.cycle_members().values() if item["id"] in members), None)
        if not name or name == self.sprint_of(item):
            return None
        return name if (name in open_sprints if open_sprints is not None else self.open_sprint(name)) else None

    def sprint_root(self, name):
        """Sprint <name>'s root work item, created on first use (labeled lb-sprint, in todo). A closed one (sprint
        landed before) goes back to todo: same name, same sprint."""
        found = self.sprint_roots(name)
        if found:
            root = found[0]
            if self.config["state_groups"].get(root["state"]) in PLANE_CLOSED_GROUPS:
                self.set_state({"number": self.key(root)}, "todo")
            return self.items[self.key(root)]
        body = "Sprint: its tickets are the children of this card; the cycle of the same name shows them."
        return self.remember(self.api("POST", f"{self.base()}/work-items/", {
            "name": name, "description_html": plane_html(body), "state": self.config["state_ids"]["todo"],
            "labels": [self.sprint_label()],
        }))

    def set_sprint(self, number, sprint):
        """Make the ticket a child of sprint <sprint>'s root and put it in the sprint's cycle; "" detaches it from both."""
        sprint = sprint_name(sprint)
        item = self.item(number)
        parent = self.parent_of(item)
        if parent and not self.is_root(parent):  # one parent per work item: never replace a human's own hierarchy
            raise Failure(f"{number} is already a child of {self.key(parent)} (not a sprint) — detach it first", EXIT_WRONG_STATE)
        current = sprint_name(parent["name"]) if parent else None
        if current == (sprint or None):
            return
        path = f"{self.base()}/work-items/{item['id']}/"
        if not sprint:
            self.remember(self.api("PATCH", path, {"parent": None}))
            cycle = self.find_cycle(current)
            if cycle:
                self.api("DELETE", f"{self.base()}/cycles/{cycle}/cycle-issues/{item['id']}/", missing=(404,))
            return
        root = self.sprint_root(sprint)
        self.remember(self.api("PATCH", path, {"parent": root["id"]}))
        # A work item sits in one cycle at most: adding it moves it out of the previous sprint's cycle.
        self.api("POST", f"{self.base()}/cycles/{self.sprint_cycle(sprint)}/cycle-issues/", {"issues": [item["id"]]})

    def split(self, ticket, name):
        """The work item becomes the sprint's root: labeled lb-sprint, so `list`, `get` and claims skip it. Plane has no
        "off the board": it keeps its column. The sprint's cycle is created now, empty; children join both with
        create --sprint. Key, history and module stay."""
        number = ticket["number"]
        clash = [r for r in self.sprint_roots(name) if self.key(r) != number]
        if clash:
            raise Failure(f"sprint {name!r} already exists ({self.key(clash[0])}) — retitle {number} first", EXIT_WRONG_STATE)
        label = self.sprint_label()
        item = self.item(number)
        labels = list(item.get("labels") or [])
        if label not in labels:  # Plane replaces the label list whole
            self.remember(self.api("PATCH", f"{self.base()}/work-items/{item['id']}/", {"labels": labels + [label]}))
        self.sprint_cycle(name)
        self.comment(number, f"🌳 **split** — sprint `{name}`: its tickets are the children of this card, in cycle `{name}`")

    def open_sprint(self, name):
        """Key of sprint <name>'s root while it is open (not in Done or Canceled), else None."""
        roots = [r for r in self.sprint_roots(name) if self.config["state_groups"].get(r["state"]) not in PLANE_CLOSED_GROUPS]
        return self.key(roots[0]) if roots else None

    def sprint_parent(self, number):
        """(key, name) of the ticket's sprint root while it is open, else None."""
        parent = self.parent_of(self.item(number))
        if not parent or not self.is_root(parent) or self.config["state_groups"].get(parent["state"]) in PLANE_CLOSED_GROUPS:
            return None
        return self.key(parent), sprint_name(parent["name"])

    def sprint_complete(self, root):
        """Every child of sprint root <root> sits in Done or Canceled."""
        root_id = self.item(root)["id"]
        children = [i for i in self.board_items() if i.get("parent") == root_id]
        return all(self.config["state_groups"].get(i["state"]) in PLANE_CLOSED_GROUPS for i in children)

    def close_sprint(self, root, why):
        """Sprint landed: its root to Done (priority kept), 🏁 comment. The cycle stays as Plane's record of it."""
        self.set_state({"number": root}, "done")
        self.comment(root, f"🏁 **sprint landed** — {why}")

    # ------------------------------------------------ pull requests (work-item links)

    def links(self, number):
        return plane_all(self.config["plane_url"], f"{self.base()}/work-items/{self.item(number)['id']}/links/")

    def linked_prs(self, number, links=None):
        """Numbers of this repository's pull requests linked on the card, from its links (read here unless given)."""
        pattern = re.compile(rf"/{re.escape(self.config['repo'])}/pull/(\d+)/?$")
        links = self.links(number) if links is None else links
        return sorted({int(m.group(1)) for m in (pattern.search(l.get("url") or "") for l in links) if m})

    def link_pr(self, number, pr, title=None, url=None):
        """Work-item link to PR <pr>, titled `#<pr> <title>`. Idempotent: Plane refuses the same URL twice on a card
        (HTTP 400), so the links are read first, and a 400 from a racing writer counts as linked once re-read.
        Returns True when the link was added."""
        if not url or not title:
            pull = rest("GET", f"repos/{self.config['repo']}/pulls/{pr}")
            url, title = url or pull["html_url"], title or pull["title"]
        if pr in self.linked_prs(number):
            return False
        path = f"{self.base()}/work-items/{self.item(number)['id']}/links/"
        try:
            self.api("POST", path, {"url": url, "title": f"#{pr} {title}"})
        except Failure:
            if pr not in self.linked_prs(number):
                raise
            return False
        return True

    # ------------------------------------------------ setup

    @classmethod
    def provision(cls, args, repo):
        url, slug = args.plane_url.rstrip("/"), args.workspace
        projects = plane_all(url, f"workspaces/{slug}/projects/")
        project = next((p for p in projects if args.project in (p["identifier"], p["id"])), None)
        if project and args.create and project["name"] != args.create:
            # A rerun adopts the project it created; another team's project with that identifier is not this board.
            raise Failure(f"project {project['identifier']} already exists, named {project['name']!r} — pick another "
                          "identifier, or drop --create to adopt it", EXIT_USAGE)
        created = not project and bool(args.create)
        if created:
            # The identifier is the ticket key: the receiver and the hooks match [A-Za-z][A-Za-z0-9]{0,11}-n.
            if not re.fullmatch(r"[A-Z][A-Z0-9]{0,11}", args.project):
                raise Failure(f"project identifier {args.project!r}: 1 to 12 capital letters or digits, a letter first", EXIT_USAGE)
            if re.search(PLANE_NAME_FORBIDDEN, args.create):
                raise Failure(f"project name {args.create!r}: Plane refuses any of {PLANE_NAME_FORBIDDEN[1:-1]}", EXIT_USAGE)
            # Plane seeds Backlog, Todo, In Progress, Done, Cancelled; the API key's user becomes its admin.
            project = plane_api(url, "POST", f"workspaces/{slug}/projects/", {"name": args.create, "identifier": args.project})
        if not project:
            known = ", ".join(p["identifier"] for p in projects) or "none"
            raise Failure(f"no Plane project {args.project!r} in workspace {slug} (projects: {known}) — "
                          "pass --create <name> to create it", EXIT_USAGE)
        base = f"workspaces/{slug}/projects/{project['id']}"
        # --create on a project that exists is a rerun (one cut short after the POST): set it up as new all the same.
        fresh = bool(args.create)
        wanted = PLANE_NEW_PROJECT_FEATURES if fresh else PLANE_FEATURES
        features = [f for f, flag in wanted.items() if not project.get(flag)]
        if features:
            # A PATCH, not the POST: only PATCH intake_view=true creates the project's default intake.
            plane_api(url, "PATCH", f"{base}/", {wanted[f]: True for f in features})
        names = {}
        for pair in args.state or []:
            state, _, name = pair.partition("=")
            if state not in PLANE_STATES:
                raise Failure(f"unknown state {state!r}, expected one of {list(PLANE_STATES)}", EXIT_USAGE)
            names[state] = name
        adopt = json.loads(args.adopt_states) if args.adopt_states else None
        state_ids, report = ensure_plane_states(url, base, names, args.prune_status, adopt, fresh=fresh)
        labels_renamed = rename_labels(url, base, args.rename_label or [])
        labels_created = ensure_plane_labels(url, base)
        # A PR based on a ticket branch retargets only when that branch is deleted on merge.
        rest("PATCH", f"repos/{repo}", {"delete_branch_on_merge": True})
        variables = {
            "PLANE_URL": url,
            "PLANE_WORKSPACE": slug,
            "PLANE_PROJECT_ID": project["id"],
            "PLANE_STATES": json.dumps(state_ids),
            "PLANE_SPECS_PATH": args.specs_path.strip("/"),
            "PLANE_STALE_AFTER_HOURS": str(args.stale_after_hours),
            "PLANE_SPRINT_PREFIX": args.sprint_prefix or "none",  # "none": an empty variable reads as unset
            "PLANE_TRACKS": json.dumps(args.track or []),
        }
        set_variables(repo, variables)
        remaining = plane_call(url, "GET", "users/me/")[1].get("X-RateLimit-Remaining")
        return {
            "project_url": f"{url}/{slug}/projects/{project['id']}/issues/",
            "project_key": project["identifier"],
            "project_id": project["id"],
            "project_created": created,
            "states_created": report["created"],
            "states_updated": report["updated"],
            "states_removed": report["removed"],
            "states_extra": report["extra"],
            "states_held": report["held"],
            "default_state_changed": report["default_changed"],
            "labels_created": labels_created,
            "labels_renamed": labels_renamed,
            "features_enabled": features,
            "state_ids": state_ids,
            "variables": variables,
            "api_rate_limit_remaining": int(remaining) if (remaining or "").isdigit() else None,
            "api_rate_limit_lifted": (remaining or "").isdigit() and int(remaining) > PLANE_LIFTED,
        }

    @classmethod
    def check_integration(cls, url, slug):
        """Plane's GitHub integration: on (installed for the workspace), off (none listed, or no integration
        route on Community Edition), unknown (route unreadable with an API key, or absent on another edition)."""
        key = os.environ.get(PLANE_KEY_ENV)
        if not key:
            raise Failure(f"{PLANE_KEY_ENV} not set — export the Plane API key in this shell (never in the repo or config)")
        _, instance = plane_probe(url, "api/instances/")
        edition = ((instance or {}).get("instance") or {}).get("edition") if isinstance(instance, dict) else None
        route = PLANE_INTEGRATIONS.format(slug=slug)
        status, rows = plane_probe(url, route, key)
        if isinstance(rows, dict):
            rows = rows.get("results")
        installed = []
        for row in rows if isinstance(rows, list) else []:
            detail = row.get("integration_detail") or row.get("integration") or {}
            names = [row.get("provider"), row.get("title")]
            if isinstance(detail, dict):
                names += [detail.get("provider"), detail.get("title")]
            if any("github" in str(name).lower() for name in names if name):
                installed.append(next(str(n) for n in names if n))
        if installed:
            found, reason = "on", f"workspace {slug} has the GitHub integration installed"
        elif status == 200 and isinstance(rows, list):
            found, reason = "off", f"workspace {slug} lists no GitHub integration"
        elif status == 404 and edition == PLANE_COMMUNITY:
            found, reason = "off", "Plane Community Edition ships no GitHub integration (no integration route)"
        else:
            found = "unknown"
            reason = f"integration list answered HTTP {status} on edition {edition or 'unknown'}: check it in Plane by hand"
        report = {"github_integration": found, "edition": edition, "probe": {"route": route, "status": status},
                  "installed": installed, "reason": reason}
        if found != "off":
            report["fix"] = PLANE_INTEGRATION_FIX
        return report


# ---------------------------------------------------------------- claims, branches and specs (code host)


def claims(config, number=None):
    """Live claims, all of them or one ticket's. Map by number, or list when number given."""
    scope = f"{CLAIM_NAMESPACE}/{number}/" if number is not None else f"{CLAIM_NAMESPACE}/"
    code, data = rest("GET", f"repos/{config['repo']}/git/matching-refs/{scope}", check=False)
    if code != 0 or not isinstance(data, list):
        message = data.get("message", "gh api failed") if isinstance(data, dict) else "gh api failed"
        raise Failure(f"could not list claims: {message}")
    found = {}
    for ref in data:
        _, _, held_by, phase = ref["ref"].split("/", 3)
        found.setdefault(held_by, []).append({"phase": phase, "sha": ref["object"]["sha"]})
    return found if number is None else found.get(number, [])


def claim_fields(config, sha):
    """Trailer lines of a claim commit (agent, claimed, account, assigned), plus its commit date."""
    commit = rest("GET", f"repos/{config['repo']}/git/commits/{sha}")
    fields = dict(line.split(": ", 1) for line in commit["message"].splitlines()[1:] if ": " in line)
    return {**fields, "date": commit["committer"]["date"]}


def claim_owner(config, sha):
    fields = claim_fields(config, sha)
    return {"agent": fields.get("agent", "?"), "since": fields["date"]}


def with_claims(config, ticket, held, with_owners=False, keep_sha=False):
    """The board's ticket with its live claims (owner fields resolved on demand, one call per claim)."""
    if with_owners:
        held = [{**c, **claim_owner(config, c["sha"])} for c in held]
    ticket["claims"] = [dict(c) if keep_sha else {k: v for k, v in c.items() if k != "sha"} for c in held]
    return ticket


def find(board, number, with_owners=True):
    return with_claims(board.config, board.get(number), claims(board.config, number), with_owners)


def claim_held(config, number, phase):
    return any(c["phase"] == phase for c in claims(config, number))


def drop_claim(config, number, phase):
    """Delete a claim ref; already gone is fine. Assignees stay: only review and done change them."""
    rest("DELETE", f"repos/{config['repo']}/git/refs/{CLAIM_NAMESPACE}/{number}/{phase}", check=False)


def agent_id(explicit=None):
    if explicit:
        return explicit
    if os.environ.get("LB_BOARD_AGENT"):
        return os.environ["LB_BOARD_AGENT"]
    try:
        where = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        where = os.getcwd()
    return f"{socket.gethostname().split('.')[0]}:{where}"


def claim_tree(config):
    """One-file tree for claim commits. Never reuse a branch tree: once it holds `.github/workflows/`, GitHub refuses
    (404) a ref to a commit adding workflow files unless the token has the `workflow` scope."""
    return rest("POST", f"repos/{config['repo']}/git/trees", {
        "tree": [{"path": "CLAIM", "mode": "100644", "type": "blob", "content": "lb-board claim\n"}],
    })["sha"]


def ticket_branches(board):
    """{ticket: {branch: head sha}} of the remote branches naming exactly one ticket of the board."""
    code, refs = rest("GET", f"repos/{board.config['repo']}/git/matching-refs/heads/", check=False)
    found = {}
    for ref in refs if code == 0 and isinstance(refs, list) else []:
        branch = ref["ref"][len("refs/heads/"):]
        keys = board.keys_in(branch)
        if len(keys) == 1:
            found.setdefault(keys[0], {})[branch] = ref["object"]["sha"]
    return found


def spec_at(config, number, sha):
    """(path, text) of the ticket's spec `{specs}/<key>*.md` in commit <sha> with a non-empty `## Acceptance
    criteria`, or None. The file name carries the key, any case: `docs/specs/CUM-12-login.md`."""
    specs = config["specs_path"]
    code, listing = rest("GET", f"repos/{config['repo']}/contents/{quote(specs)}?ref={sha}", check=False)
    if code != 0 or not isinstance(listing, list):
        return None
    name = re.compile(rf"^{re.escape(number)}(?!\d).*\.md$", re.I)
    for found in sorted((f for f in listing if name.match(f["name"])), key=lambda f: f["name"]):
        data = rest("GET", f"repos/{config['repo']}/contents/{quote(found['path'])}?ref={sha}")
        text = base64.b64decode(data["content"]).decode("utf-8", "replace")
        if spec_section(text, "Acceptance criteria"):
            return found["path"], text
    return None


def spec_section(text, heading):
    """Body of `## <heading>` without HTML comments, trimmed: "" when missing or empty."""
    parts = re.split(rf"^## {re.escape(heading)}\s*$", text, maxsplit=1, flags=re.M)
    if len(parts) < 2:
        return ""
    body = re.split(r"^## ", parts[1], maxsplit=1, flags=re.M)[0]
    return re.sub(r"<!--[\s\S]*?-->", "", body).strip()


# ---------------------------------------------------------------- operations


def op_config(args):
    emit(load())


def op_list(args):
    board = open_board()
    config = board.config
    claim_map = claims(config)
    with_prs = open_ticket_prs(board)[0]
    wanted = set(args.state.split(",")) if args.state else None
    rows = []
    for ticket in board.tickets():
        if ticket["ignored"]:
            continue
        if ticket["closed"] and not args.all:  # canceled
            continue
        if wanted and ticket["state"] not in wanted:
            continue
        if not wanted and not args.all and ticket["state"] == "done":
            continue
        if args.mine and not ticket["mine"]:
            continue
        if args.sprint and ticket["sprint"] != sprint_name(args.sprint):
            continue
        if args.milestone and ticket["milestone"] != args.milestone:
            continue
        with_claims(config, ticket, claim_map.get(ticket["number"], []), keep_sha=args.owners)
        ticket["open_prs"] = sorted(with_prs.get(ticket["number"], []))
        rows.append(ticket)
    if args.owners:
        claimed = [c for t in rows for c in t["claims"]]
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            for claim, owner in zip(claimed, pool.map(lambda c: claim_owner(config, c["sha"]), claimed)):
                claim.update(owner)
        for claim in claimed:
            claim.pop("sha")
    emit(rows)


def op_get(args):
    board = open_board()
    config = board.config
    ticket = find(board, args.number)
    branches = ticket_branches(board).get(args.number, {})
    ticket["branches"] = sorted(branches)
    ticket["spec"] = next((s[0] for s in (spec_at(config, args.number, sha) for sha in branches.values()) if s), None)
    ticket["linked_prs"] = board.linked_prs(args.number)
    ticket["blocked_by"] = board.blocked_by(args.number)
    ticket["stray_sprint"] = board.stray_sprint(args.number)
    emit(ticket)


def op_create(args):
    board = open_board()
    body = args.summary + ("\n\n" + args.note if args.note else "")
    created = board.create(args.title, body, args.priority, args.assignee, args.milestone, args.sprint)
    emit({**created, "state": "todo"})


def op_claim(args):
    board = open_board()
    config = board.config
    phase = args.phase
    ticket = find(board, args.number, with_owners=False)
    if ticket["closed"]:
        raise Failure(f"{args.number} is closed", EXIT_WRONG_STATE)
    if ticket["reserved"]:
        who = ", ".join(ticket["assignees"])
        emit({"number": args.number, "phase": phase, "taken": True, "agent": who, "assigned": True})
        raise Failure(f"{args.number} is assigned to {who}, not to {board.me()}", EXIT_TAKEN)
    ref = f"refs/{CLAIM_NAMESPACE}/{args.number}/{phase}"
    agent = agent_id(args.agent)
    held = next((c for c in claims(config, args.number) if c["phase"] == phase), None)
    if held:  # before the state check, so a loser learns who holds it; leaves no commit behind
        owner = claim_owner(config, held["sha"])
        if owner["agent"] == agent:  # a retry by the holder: still yours
            emit({"number": args.number, "phase": phase, "taken": False, "agent": agent, "since": owner["since"], "already": True})
            return
        taken(config, args.number, phase, held["sha"])
    if ticket["state"] not in CLAIM_FROM[phase]:
        where = ticket["state"] or f"in column {ticket['column']!r}"
        raise Failure(f"{args.number} is {where}, {phase} needs {sorted(CLAIM_FROM[phase])}", EXIT_WRONG_STATE)
    if phase == "coding" and ticket["state"] in ("todo", "grilled") and not args.blocked_ok:
        # First coding round only: a ticket in review already has its PR. Coding on an open blocker on purpose
        # (stacked on it, or unrelated) passes --blocked-ok.
        blockers = [b["number"] for b in board.blocked_by(args.number) if b["state"] == "open"]
        if blockers:
            raise Failure(
                f"{args.number} is blocked by {', '.join(blockers)} (open) — land {'it' if len(blockers) == 1 else 'them'}"
                " first, or claim with --blocked-ok to code it anyway", EXIT_WRONG_STATE,
            )
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    # The winner assigns its account, so others see the ticket reserved. Recorded in the claim so `release` gives
    # back only an assignment this claim made. `account:` names the claimer whatever happens, so the review hook
    # can assign the round's dev to a ticket left unassigned.
    login = board.me()
    assigning = not ticket["mine"]
    trailer = f"assigned: {login}\n" if assigning else ""
    commit = rest("POST", f"repos/{config['repo']}/git/commits", {
        "message": f"lb-claim {phase} {args.number}\n\nagent: {agent}\nclaimed: {now}\naccount: {board.account()}\n{trailer}",
        "tree": claim_tree(config),
        "parents": [],
    })
    code, data = rest("POST", f"repos/{config['repo']}/git/refs", {"ref": ref, "sha": commit["sha"]}, check=False)
    if code != 0:
        if (data or {}).get("message") != "Reference already exists":
            raise Failure(f"could not create claim ref {ref}: {(data or {}).get('message', 'unknown error')}")
        existing = rest("GET", f"repos/{config['repo']}/git/ref/{ref[len('refs/'):]}")
        taken(config, args.number, phase, existing["object"]["sha"])
    if ticket["state"] in ("todo", "grilled"):
        # Both phases claim from `todo` and `grilled` on two refs, so the ref alone isn't the lock. Checked after
        # creating ours: of two racers, the later checker always sees the other one. Two simultaneous checkers can
        # both back off: never two winners, at worst none (claim again later).
        other = next((c for c in claims(config, args.number) if c["phase"] != phase), None)
        if other:
            rest("DELETE", f"repos/{config['repo']}/git/{ref}", check=False)
            taken(config, args.number, other["phase"], other["sha"])
    try:
        board.set_state(ticket, phase)
    except BaseException:  # a lock on a card that never moved misleads everyone: give the ref back
        rest("DELETE", f"repos/{config['repo']}/git/{ref}", check=False)
        raise
    if assigning and not board.assign(args.number, login):
        note(f"warning: claim held, but could not assign {login} to {args.number}")
    board.comment(args.number, f"🔒 **{phase}** — `{agent}` · {now}")
    emit({"number": args.number, "phase": phase, "taken": False, "agent": agent, "since": now})


def taken(config, number, phase, sha):
    owner = claim_owner(config, sha)
    emit({"number": number, "phase": phase, "taken": True, **owner})
    raise Failure(f"{number} {phase} already claimed by {owner['agent']} since {owner['since']}", EXIT_TAKEN)


def op_release(args):
    board = open_board()
    config = board.config
    ref = f"{CLAIM_NAMESPACE}/{args.number}/{args.phase}"
    held = next((c for c in claims(config, args.number) if c["phase"] == args.phase), None)
    assigned = claim_fields(config, held["sha"]).get("assigned") if held else None
    code, data = rest("DELETE", f"repos/{config['repo']}/git/refs/{ref}", check=False)
    if code != 0 and held:  # the ref is there but stays: never reset a card whose lock is still held
        raise Failure(f"could not release {ref}: {(data or {}).get('message', 'gh api failed')}")
    if code == 0 and assigned:  # undo only the assignment this claim made; a human's stays
        board.unassign(args.number, assigned)
    if args.reset_to:
        board.set_state(find(board, args.number, with_owners=False), args.reset_to)
    reason = f" — {args.reason}" if args.reason else ""
    target = f", back to **{args.reset_to}**" if args.reset_to else ""
    board.comment(args.number, f"🔓 **{args.phase}** released{target}{reason}")
    emit({"number": args.number, "phase": args.phase, "released": code == 0, "state": args.reset_to})


def op_cancel(args):
    """Ticket closed as not planned: off the board, never claimable, never counted done. A claimed ticket is
    released first; a landed one stays done."""
    board = open_board()
    number = args.number
    ticket = find(board, number, with_owners=False)
    if ticket["not_planned"]:
        emit({"number": number, "canceled": True, "already": True})
        return
    if ticket["closed"]:
        raise Failure(f"{number} is closed (landed), not canceled", EXIT_WRONG_STATE)
    if ticket["claims"]:
        held = ", ".join(c["phase"] for c in ticket["claims"])
        raise Failure(f"{number} is claimed ({held}) — release it first", EXIT_WRONG_STATE)
    board.set_state(ticket, "canceled")
    board.comment(number, "🚫 **canceled**" + (f" — {args.reason}" if args.reason else ""))
    emit({"number": number, "canceled": True})


def op_move(args):
    open_board().move(args.number, before=args.before, after=args.after, bottom=args.bottom)
    emit({"number": args.number, "moved": True})


def op_depend(args):
    """Record that <number> is blocked by each ticket in --on. Idempotent."""
    added, kept = open_board().depend(args.number, args.on)
    emit({"number": args.number, "blocked_by_added": added, "blocked_by_existing": kept})


def op_set_field(args):
    board = open_board()
    if args.field == "sprint":
        board.set_sprint(args.number, args.value)
    else:
        board.set_milestone(args.number, args.value)
    emit({"number": args.number, args.field: args.value or None})


def op_milestones(args):
