# ---------------------------------------------------------------- settings


def current_repo():
    if os.environ.get("GITHUB_ACTIONS") == "true" and os.environ.get("GITHUB_REPOSITORY"):  # a hooks run
        return os.environ["GITHUB_REPOSITORY"]
    return gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).stdout.strip()


def repo_variables(repo):
    # Hooks run: the receiver hands the variables over (the App's token can read them, a hook's GH_TOKEN can't list).
    if os.environ.get("LB_BOARD_VARS"):
        return {k: v for k, v in json.loads(os.environ["LB_BOARD_VARS"]).items() if isinstance(v, str)}
    data = rest("GET", f"repos/{repo}/actions/variables?per_page=100")
    return {v["name"]: v["value"] for v in data.get("variables", [])}


def set_variables(repo, variables):
    for name, value in variables.items():
        gh(["variable", "set", name, "--repo", repo, "--body", value])


@functools.lru_cache(maxsize=None)
def load():
    """Settings of this run: repo, board ids (read fresh from Plane, no cache to go stale), specs path."""
    repo = current_repo()
    variables = repo_variables(repo)
    return {
        "repo": repo,
        **Board.settings(repo, variables),
        "specs_path": variables.get("PLANE_SPECS_PATH", "docs/specs").strip("/"),
        "stale_after_hours": int(variables.get("PLANE_STALE_AFTER_HOURS", "24")),
        # "none" = sprints have no branch (an empty variable reads as unset); the default: no sprint branches
        "sprint_prefix": "" if variables.get("PLANE_SPRINT_PREFIX", "none") == "none" else variables["PLANE_SPRINT_PREFIX"],
        "tracks": json.loads(variables.get("PLANE_TRACKS", "[]")),
    }


def open_board():
    return Board(load())


def sprint_name(title):
    """Kebab-case of a sprint title: the branch-safe name."""
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")


def milestone_rank(milestone):
    """Version order of the title (digit runs compared as numbers: 0.10.0 > 0.9.0 > 0.3.0 > 0.2.1), then creation order."""
    parts = re.findall(r"\d+|\D+", milestone["title"].casefold())
    return [(1, int(part), "") if part.isdigit() else (0, 0, part) for part in parts], milestone["number"]


def summary_of(body):
    for line in (body or "").splitlines():
        line = line.strip()
        if line and not line.startswith("<!--"):
            return line
    return ""


